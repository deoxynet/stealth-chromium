+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_FINGERPRINT_FINGERPRINT_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_FINGERPRINT_FINGERPRINT_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/command_line.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "third_party/blink/public/common/switches.h"
+
+// Identity-seed driven anti-fingerprinting core.
+//
+// One 64-bit identity seed (--fingerprint, decimal ASCII) drives every
+// deterministic spoof in the Stealth Chromium series. When the seed is absent the
+// browser process mints a random one at startup (see
+// ChromeMainDelegate::BasicStartupComplete), so fingerprinting is on by
+// default; passing --fingerprint=off (also false/0/disable/disabled) turns
+// the whole system off and every helper below degrades to "return nothing",
+// at which point call sites fall back to stock Chromium behavior.
+//
+// Hash derivation here is deliberately our own (FNV-1a + splitmix64): it is
+// stable across libc++ versions and platforms, unlike std::hash<std::string>.
+// Exact output values are therefore not identical to any other
+// implementation; only determinism per (seed, purpose) is guaranteed.
+namespace blink::fingerprint {
+
+// True unless --fingerprint is absent-and-unminted or set to an explicit
+// off-value. The browser process always mints a seed, so in practice this is
+// false only for explicit opt-out or in unit tests that never set the switch.
+inline bool Enabled() {
+  static const bool enabled = [] {
+    const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+    if (!cmd.HasSwitch(switches::kFingerprint)) {
+      return false;
+    }
+    const std::string value = base::ToLowerASCII(
+        cmd.GetSwitchValueASCII(switches::kFingerprint));
+    return value != "off" && value != "false" && value != "0" &&
+           value != "disable" && value != "disabled";
+  }();
+  return enabled;
+}
+
+// Parsed identity seed; nullopt when fingerprinting is disabled. Cached:
+// the command line is immutable by the time renderer code runs.
+inline std::optional<uint64_t> Seed() {
+  static const base::NoDestructor<std::optional<uint64_t>> seed([] {
+    if (!Enabled()) {
+      return std::optional<uint64_t>();
+    }
+    const std::string value = base::CommandLine::ForCurrentProcess()
+                                  ->GetSwitchValueASCII(switches::kFingerprint);
+    uint64_t parsed = 0;
+    if (!base::StringToUint64(value, &parsed)) {
+      return std::optional<uint64_t>();
+    }
+    return std::optional<uint64_t>(parsed);
+  }());
+  return *seed;
+}
+
+// Raw seed string ("" when disabled) — for hashing contexts that want the
+// original decimal text.
+inline std::string SeedString() {
+  if (!Seed()) {
+    return std::string();
+  }
+  return base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+      switches::kFingerprint);
+}
+
+// The noise family (canvas/measureText/clientRects/audio) is gated by
+// --fingerprint-noise; only the literal value "false" opts out.
+inline bool NoiseEnabled() {
+  static const bool enabled = [] {
+    if (!Enabled()) {
+      return false;
+    }
+    return base::CommandLine::ForCurrentProcess()
+               ->GetSwitchValueASCII(switches::kFingerprintNoise) != "false";
+  }();
+  return enabled;
+}
+
+// Spoofed desktop platform from --fingerprint-platform
+// ("windows"|"macos"|"linux"; anything else means no platform spoof).
+enum class Platform { kNone, kWindows, kMacOs, kLinux };
+
+inline Platform SpoofedPlatform() {
+  static const Platform platform = [] {
+    const std::string value = base::ToLowerASCII(
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            switches::kFingerprintPlatform));
+    if (value == "windows") {
+      return Platform::kWindows;
+    }
+    if (value == "macos" || value == "darwin") {
+      return Platform::kMacOs;
+    }
+    if (value == "linux") {
+      return Platform::kLinux;
+    }
+    return Platform::kNone;
+  }();
+  return platform;
+}
+
+// FNV-1a 64-bit over bytes; stable and dependency-free.
+inline uint64_t Hash(std::string_view text) {
+  uint64_t hash = 1469598103934665603ULL;  // FNV-1a 64 offset basis
+  for (const char c : text) {
+    hash ^= static_cast<uint8_t>(c);
+    hash *= 1099511628211ULL;  // FNV-1a 64 prime
+  }
+  return hash;
+}
+
+// splitmix64 finalizer — turns lumpy hashes into uniform ones.
+inline uint64_t Mix(uint64_t x) {
+  x += 0x9E3779B97F4A7C15ULL;
+  x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ULL;
+  x = (x ^ (x >> 27)) * 0x94D049BB133111EBULL;
+  return x ^ (x >> 31);
+}
+
+// Deterministic 64-bit value for a purpose string; identical seeds derive
+// identical values, different purposes derive independent values.
+inline uint64_t HashFor(std::string_view purpose) {
+  const std::string key = SeedString() + ":" + std::string(purpose);
+  return Mix(Hash(key));
+}
+
+// Deterministic double in [0, 1) for a purpose string.
+inline double RandomFor(std::string_view purpose) {
+  return static_cast<double>(HashFor(purpose) >> 11) *
+         (1.0 / 9007199254740992.0);  // 2^53
+}
+
+// Deterministic integer in [0, bound); bound must be > 0.
+inline uint32_t RandomBelow(std::string_view purpose, uint32_t bound) {
+  return static_cast<uint32_t>(HashFor(purpose) % bound);
+}
+
+// Small linear congruential generator for the noise family, seeded from the
+// identity. Multiplier/increment constants reproduce the vendor LCG
+// (0x17385CA9 / 0x47502932); the emitted sequences are deterministic per
+// seed + salt but not bit-identical to any other build.
+class NoiseLcg {
+ public:
+  explicit NoiseLcg(std::string_view salt)
+      : state_(HashFor(salt) ^ 0x17385CA9ULL) {}
+
+  uint64_t Next() {
+    state_ = state_ * 0x17385CA9ULL + 0x47502932ULL;
+    return state_;
+  }
+
+  // Uniform integer in [0, bound) without modulo bias for small bounds.
+  uint32_t NextBelow(uint32_t bound) {
+    return static_cast<uint32_t>(Next() >> 32) % bound;
+  }
+
+  double NextDouble() {
+    return static_cast<double>(Next() >> 11) * (1.0 / 9007199254740992.0);
+  }
+
+ private:
+  uint64_t state_;
+};
+
+// Switch value parsers shared by several patches. Return fallback when
+// fingerprinting is off or the switch is absent/unparseable.
+inline std::optional<uint64_t> SwitchUint(std::string_view switch_name) {
+  if (!Enabled()) {
+    return std::nullopt;
+  }
+  const std::string value =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          std::string(switch_name));
+  uint64_t parsed = 0;
+  if (value.empty() || !base::StringToUint64(value, &parsed)) {
+    return std::nullopt;
+  }
+  return parsed;
+}
+
+inline std::optional<double> SwitchDouble(std::string_view switch_name) {
+  if (!Enabled()) {
+    return std::nullopt;
+  }
+  const std::string value =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          std::string(switch_name));
+  double parsed = 0.0;
+  if (value.empty() || !base::StringToDouble(value, &parsed)) {
+    return std::nullopt;
+  }
+  return parsed;
+}
+
+}  // namespace blink::fingerprint
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_COMMON_FINGERPRINT_FINGERPRINT_H_
