 #include "base/system/sys_info.h"
+#include "third_party/blink/public/common/fingerprint/fingerprint.h"
 
 namespace blink {
 
 unsigned NavigatorConcurrentHardware::hardwareConcurrency() const {
+  // Stealth Chromium: explicit thread-count override; 8-thread persona default
+  // when only the identity seed is present.
+  if (auto count =
+          fingerprint::SwitchUint(switches::kFingerprintHardwareConcurrency)) {
+    if (*count != 0) {
+      return static_cast<unsigned>(*count);
+    }
+  }
+  if (fingerprint::Seed()) {
+    return 8u;
+  }
   return static_cast<unsigned>(base::SysInfo::NumberOfProcessors());
 }
 
