From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stealth Chromium contributors
Date: Thu, 1 Jan 2026 00:00:00 +0000
Subject: [PATCH 7/33] fingerprint: screen dimensions, taskbar band and media-query consistency
X-Spec: patches/11-screen-dimensions.md
X-Files: third_party/blink/renderer/core/frame/screen.cc third_party/blink/renderer/core/css/media_values.cc third_party/blink/renderer/core/fingerprint/screen_dimensions.h

---

--- a/third_party/blink/renderer/core/frame/screen.cc
+++ b/third_party/blink/renderer/core/frame/screen.cc
@@ -31,6 +31,7 @@
 #include "base/numerics/safe_conversions.h"
 #include "services/network/public/mojom/permissions_policy/permissions_policy_feature.mojom-blink.h"
 #include "third_party/blink/renderer/core/event_target_names.h"
+#include "third_party/blink/renderer/core/fingerprint/screen_dimensions.h"
 #include "third_party/blink/renderer/core/frame/local_dom_window.h"
 #include "third_party/blink/renderer/core/frame/local_frame.h"
 #include "third_party/blink/renderer/core/frame/settings.h"
@@ -81,12 +82,20 @@
 int Screen::height() const {
   if (!DomWindow())
     return 0;
+  // Stealth Chromium: switch override, then persona default (900 on macOS).
+  if (auto h = fingerprint::SpoofedScreenHeight()) {
+    return *h;
+  }
   return GetRect(/*available=*/false).height();
 }
 
 int Screen::width() const {
   if (!DomWindow())
     return 0;
+  // Stealth Chromium: switch override, then persona default (1440 on macOS).
+  if (auto w = fingerprint::SpoofedScreenWidth()) {
+    return *w;
+  }
   return GetRect(/*available=*/false).width();
 }
 
@@ -124,12 +133,26 @@
 int Screen::availHeight() const {
   if (!DomWindow())
     return 0;
+  // Stealth Chromium: spoofed height minus the persona taskbar/Dock band.
+  if (auto h = fingerprint::SpoofedScreenHeight()) {
+    return fingerprint::ApplyTaskbar(*h, fingerprint::TaskbarHeight());
+  }
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          blink::switches::kFingerprintPlatform)) {
+    // No height spoof, but a platform persona still claims its taskbar.
+    return GetRect(/*available=*/false).height() -
+           fingerprint::ApplyTaskbar(0, fingerprint::TaskbarHeight());
+  }
   return GetRect(/*available=*/true).height();
 }
 
 int Screen::availWidth() const {
   if (!DomWindow())
     return 0;
+  // Stealth Chromium: availWidth mirrors width() (horizontal taskbar assumption).
+  if (auto w = fingerprint::SpoofedScreenWidth()) {
+    return *w;
+  }
   return GetRect(/*available=*/true).width();
 }
 
