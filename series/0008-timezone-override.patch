+// Stealth Chromium: the persona timezone from --fingerprint-timezone, when set.
+// Accepts IANA ids (America/New_York) and custom offsets (GMT+8); empty or
+// unset means no override.
+String FingerprintTimezoneId() {
+  const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+  if (!cmd.HasSwitch(blink::switches::kFingerprintTimezone)) {
+    return String();
+  }
+  const std::string value =
+      cmd.GetSwitchValueASCII(blink::switches::kFingerprintTimezone);
+  if (value.empty() || !base::IsStringASCII(value)) {
+    return String();
+  }
+  return String::FromUTF8(value);
+}
+
 String GetCurrentTimezoneId() {
+  if (String fingerprint_tz = FingerprintTimezoneId(); !fingerprint_tz.empty()) {
+    return fingerprint_tz;
+  }
   std::unique_ptr<icu::TimeZone> timezone(icu::TimeZone::createDefault());
   CHECK(timezone);
   return GetTimezoneId(*timezone.get());
@@ -96,6 +118,22 @@
   if (!base::FeatureList::IsEnabled(kLazyBlinkTimezoneInit)) {
     host_timezone_id_ = GetCurrentTimezoneId();
   }
+  // Stealth Chromium: adopt the persona timezone as the process ICU default so
+  // Date and Intl agree from isolate creation on. Invalid ids degrade to
+  // ICU's unknown zone (GMT) rather than falling back to the real zone.
+  if (String fingerprint_tz = FingerprintTimezoneId(); !fingerprint_tz.empty()) {
+    UErrorCode status = U_ZERO_ERROR;
+    std::unique_ptr<icu::TimeZone> timezone(icu::TimeZone::createSystemTimeZone(
+        icu::UnicodeString(fingerprint_tz.Ascii().data(), -1, US_INV), status));
+    if (!timezone || U_FAILURE(status)) {
+      timezone.reset(icu::TimeZone::createCustomTimeZone(
+          icu::UnicodeString(fingerprint_tz.Ascii().data(), -1, US_INV)));
+    }
+    if (!timezone) {
+      timezone.reset(icu::TimeZone::getUnknown()->clone());
+    }
+    icu::TimeZone::adoptDefault(timezone.release());
+  }
 }
 
