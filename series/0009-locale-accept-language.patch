   const base::CommandLine& command_line = *parameters.command_line;
 
+  // fp-patches: renderer ICU default locale follows the persona locale so
+  // Intl defaults agree with navigator.languages and Accept-Language. A
+  // comma list uses its first tag (ICU takes a single locale).
+  if (command_line.HasSwitch(blink::switches::kFingerprintLocale)) {
+    std::string locale =
+        command_line.GetSwitchValueASCII(blink::switches::kFingerprintLocale);
+    const size_t comma = locale.find(',');
+    if (comma != std::string::npos) {
+      locale.resize(comma);
+    }
+    if (!locale.empty()) {
+      base::i18n::SetICUDefaultLocale(locale);
+    }
+  }
+
