From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fp-patches contributors
Date: Thu, 1 Jan 2026 00:00:00 +0000
Subject: [PATCH 11/33] fingerprint: navigator.platform persona and Web Share capability consistency
X-Spec: patches/10-user-agent-platform.md
X-Files: third_party/blink/renderer/core/frame/navigator_id.cc chrome/renderer/chrome_content_renderer_client.cc

---

--- a/third_party/blink/renderer/core/frame/navigator_id.cc
+++ b/third_party/blink/renderer/core/frame/navigator_id.cc
@@ -31,9 +31,11 @@
 
 #include "third_party/blink/renderer/core/frame/navigator_id.h"
 
+#include "base/command_line.h"
 #include "base/feature_list.h"
 #include "build/build_config.h"
 #include "third_party/blink/public/common/features.h"
+#include "third_party/blink/public/common/switches.h"
 #include "third_party/blink/renderer/platform/wtf/text/string_builder.h"
 
 #if !BUILDFLAG(IS_MAC) && !BUILDFLAG(IS_WIN)
@@ -59,6 +61,23 @@
 }
 
 String NavigatorID::platform() const {
+  // fp-patches: persona platform token. Unknown/absent persona falls
+  // through to the real OS value.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          blink::switches::kFingerprintPlatform)) {
+    const std::string platform = base::ToLowerASCII(
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            blink::switches::kFingerprintPlatform));
+    if (platform == "windows") {
+      return "Win32";
+    }
+    if (platform == "linux") {
+      return "Linux x86_64";
+    }
+    if (platform == "macos") {
+      return "MacIntel";
+    }
+  }
 #if BUILDFLAG(IS_MAC)
   // Match Safari and Mozilla on Mac x86.
   return "MacIntel";
--- a/chrome/renderer/chrome_content_renderer_client.cc
+++ b/chrome/renderer/chrome_content_renderer_client.cc
@@ -152,6 +152,7 @@
 #include "third_party/blink/public/common/associated_interfaces/associated_interface_provider.h"
 #include "third_party/blink/public/common/features.h"
 #include "third_party/blink/public/common/features_generated.h"
+#include "third_party/blink/public/common/switches.h"
 #include "third_party/blink/public/common/tokens/tokens.h"
 #include "third_party/blink/public/mojom/fetch/fetch_api_request.mojom-shared.h"
 #include "third_party/blink/public/mojom/page/page_visibility_state.mojom.h"
@@ -1452,6 +1453,18 @@
     BUILDFLAG(IS_MAC)
   blink::WebRuntimeFeatures::EnableWebShare(true);
 #endif
+  // fp-patches: navigator.share is stock-disabled on desktop Linux; the
+  // Windows/macOS personas enable it so the capability set matches the
+  // claimed OS.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          blink::switches::kFingerprintPlatform)) {
+    const std::string platform = base::ToLowerASCII(
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            blink::switches::kFingerprintPlatform));
+    if (platform != "linux") {
+      blink::WebRuntimeFeatures::EnableWebShare(true);
+    }
+  }
 
   if (base::FeatureList::IsEnabled(
           autofill::features::kAutofillPolicyControlledFeatureAutofill)) {
