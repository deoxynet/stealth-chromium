+// static
+void StaticBitmapImage::ShuffleSubchannelColorData(const void* addr,
+                                                   const SkImageInfo& info,
+                                                   int src_x,
+                                                   int src_y) {
+  const int w = info.width() - src_x;
+  const int h = info.height() - src_y;
+  // Skip tiny images (and zero-sized readbacks).
+  if (w < 8 || h < 8) {
+    return;
+  }
+
+  const size_t row_bytes = info.minRowBytes();
+  const long total = static_cast<long>(w) * h;
+  const int count = static_cast<int>(std::min(total, 10L));
+
+  // Position stream: LCG-stepped from the seed hash (vendor constants).
+  const uint32_t pos_seed =
+      static_cast<uint32_t>(fingerprint::HashFor("canvas_pos"));
+
+  for (int i = 0; i < count; ++i) {
+    const uint32_t r =
+        ((static_cast<uint32_t>(i) ^ pos_seed) * 0x17385CA9u + 0x47502932u) %
+        static_cast<uint32_t>(total);
+    const int x = static_cast<int>(r % w);
+    const int y = static_cast<int>(r / w);
+    const uint32_t pixel_hash = static_cast<uint32_t>(fingerprint::HashFor(
+        "canvas_px_" + std::to_string(x) + "_" + std::to_string(y)));
+    const bool b0 = pixel_hash & 1;
+    const bool b1 = (pixel_hash >> 1) & 1;
+    const bool b2 = (pixel_hash >> 2) & 1;
+
+    switch (info.colorType()) {
+      case kAlpha_8_SkColorType:
+      case kGray_8_SkColorType: {
+        uint8_t* pixel = const_cast<uint8_t*>(static_cast<const uint8_t*>(
+            addr)) + y * row_bytes + x;
+        *pixel = static_cast<uint8_t>((*pixel & 0xFE) | b2);
+        break;
+      }
+      case kRGB_565_SkColorType: {
+        uint16_t* pixel = reinterpret_cast<uint16_t*>(
+            const_cast<uint8_t*>(static_cast<const uint8_t*>(addr)) +
+            y * row_bytes + x * 2);
+        const unsigned r5 = (*pixel >> 11) & 0x1F;
+        const unsigned g6 = (*pixel >> 5) & 0x3F;
+        const unsigned b5 = (*pixel) & 0x1F;
+        // Expand to 8 bits, clear the LSB, install the noise bit, truncate.
+        const unsigned r8 = (((r5 << 3) | (r5 >> 2)) & 0x1E) | b0;
+        const unsigned g8 = (((g6 << 2) | (g6 >> 4)) & 0x3E) | b1;
+        const unsigned b8 = (((b5 << 3) | (b5 >> 2)) & 0x1E) | b2;
+        *pixel = static_cast<uint16_t>((r8 << 11) | (g8 << 5) | b8);
+        break;
+      }
+      case kARGB_4444_SkColorType: {
+        uint16_t* pixel = reinterpret_cast<uint16_t*>(
+            const_cast<uint8_t*>(static_cast<const uint8_t*>(addr)) +
+            y * row_bytes + x * 2);
+        const uint16_t pv = *pixel;
+        *pixel = static_cast<uint16_t>((pv & 0xEE0F) | (b0 << 12) |
+                                       (b1 << 8) | (b2 << 4));
+        break;
+      }
+      case kRGBA_8888_SkColorType: {
+        uint32_t* pixel = reinterpret_cast<uint32_t*>(
+            const_cast<uint8_t*>(static_cast<const uint8_t*>(addr)) +
+            y * row_bytes + x * 4);
+        const uint32_t p = *pixel;
+        *pixel = (p & 0xFF000000u) | ((((p) & 0x000000FFu) & 0xFE) | b2) |
+                 (((((p >> 8) & 0xFF) & 0xFE) | b1) << 8) |
+                 (((((p >> 16) & 0xFF) & 0xFE) | b0) << 16);
+        break;
+      }
+      case kBGRA_8888_SkColorType: {
+        uint32_t* pixel = reinterpret_cast<uint32_t*>(
+            const_cast<uint8_t*>(static_cast<const uint8_t*>(addr)) +
+            y * row_bytes + x * 4);
+        const uint32_t p = *pixel;
+        // B at byte 0, G at byte 1, R at byte 2; alpha preserved.
+        *pixel = (p & 0xFF000000u) | ((((p) & 0xFF) & 0xFE) | b0) |
+                 (((((p >> 8) & 0xFF) & 0xFE) | b1) << 8) |
+                 (((((p >> 16) & 0xFF) & 0xFE) | b2) << 16);
+        break;
+      }
+      default:
+        // Unhandled formats (float, 888x, 101010x...) are skipped without
+        // altering the pixel.
+        continue;
+    }
+  }
+}
