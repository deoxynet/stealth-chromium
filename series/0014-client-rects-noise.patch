--- /dev/null
+++ b/third_party/blink/renderer/core/fingerprint/client_rects_noise.h
@@ -0,0 +1,36 @@
+// Copyright 2026 The fp-patches Authors
+// Use of this source code is governed by a GPLv3 license that can be
+// found in the LICENSE file of the fp-patches distribution.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FINGERPRINT_CLIENT_RECTS_NOISE_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FINGERPRINT_CLIENT_RECTS_NOISE_H_
+
+#include "third_party/blink/public/common/fingerprint/fingerprint.h"
+
+// Sub-pixel translation applied to get*ClientRects / getBoundingClientRect
+// results. The offset is one of ±1/64..±4/64 px per axis (never zero),
+// deterministic per identity seed, identical for every document in a
+// session. Widths/heights are never altered — only origins move.
+namespace blink::fingerprint {
+
+inline double ClientRectsNoiseX() {
+  static const double noise = [] {
+    const uint32_t v =
+        static_cast<uint32_t>(HashFor("offset_x")) & 7;
+    return static_cast<double>(v + (v >= 4 ? 1 : 0) - 4) * 0.015625;
+  }();
+  return noise;
+}
+
+inline double ClientRectsNoiseY() {
+  static const double noise = [] {
+    const uint32_t v =
+        static_cast<uint32_t>(HashFor("offset_y")) & 7;
+    return static_cast<double>(v + (v >= 4 ? 1 : 0) - 4) * 0.015625;
+  }();
+  return noise;
+}
+
+}  // namespace blink::fingerprint
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_FINGERPRINT_CLIENT_RECTS_NOISE_H_
--- a/third_party/blink/renderer/core/dom/range.cc
+++ b/third_party/blink/renderer/core/dom/range.cc
@@ -46,6 +46,7 @@
 #include "third_party/blink/renderer/core/editing/set_selection_options.h"
 #include "third_party/blink/renderer/core/editing/visible_position.h"
 #include "third_party/blink/renderer/core/editing/visible_units.h"
+#include "third_party/blink/renderer/core/fingerprint/client_rects_noise.h"
 #include "third_party/blink/renderer/core/frame/local_dom_window.h"
 #include "third_party/blink/renderer/core/frame/local_frame.h"
 #include "third_party/blink/renderer/core/frame/settings.h"
@@ -1656,6 +1657,16 @@
   Vector<gfx::QuadF> quads;
   GetBorderAndTextQuads(quads);
 
+  // fp-patches: translate quads by the seeded sub-pixel offset (pure
+  // translation; sizes unchanged).
+  if (fingerprint::NoiseEnabled()) {
+    const float dx = static_cast<float>(fingerprint::ClientRectsNoiseX());
+    const float dy = static_cast<float>(fingerprint::ClientRectsNoiseY());
+    for (gfx::QuadF& quad : quads) {
+      quad.Offset(dx, dy);
+    }
+  }
+
   return MakeGarbageCollected<DOMRectList>(quads);
 }
 
@@ -1663,7 +1674,13 @@
   // TODO(crbug.com/1499981): This should be removed once synchronized scrolling
   // impact is understood.
   SyncScrollAttemptHeuristic::DidAccessScrollOffset();
-  return DOMRect::FromRectF(BoundingRect());
+  gfx::RectF rect = BoundingRect();
+  // fp-patches: seeded sub-pixel origin translation.
+  if (fingerprint::NoiseEnabled()) {
+    rect.set_x(rect.x() + static_cast<float>(fingerprint::ClientRectsNoiseX()));
+    rect.set_y(rect.y() + static_cast<float>(fingerprint::ClientRectsNoiseY()));
+  }
+  return DOMRect::FromRectF(rect);
 }
 
