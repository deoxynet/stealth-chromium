+namespace {
+
+// Stealth Chromium: deterministic per-sample perturbation of AudioBuffer channel
+// data (±5e-6 amplitude), keyed to (identity seed, sample index). Applied
+// once per channel before JS sees the data.
+void ApplyAudioFingerprintNoise(float* data, size_t length) {
+  if (!fingerprint::NoiseEnabled() || !data || length == 0) {
+    return;
+  }
+  const uint32_t hash = static_cast<uint32_t>(fingerprint::HashFor("audio"));
+  for (size_t i = 0; i < length; ++i) {
+    uint32_t v = static_cast<uint32_t>(i) ^ hash;
+    v = v * 0x17385CA9u + 0x47502932u;
+    const float delta = static_cast<float>(
+        (static_cast<double>(v) / 4294967296.0 - 0.5) * 1e-5);
+    data[i] = std::clamp(data[i] + delta, -1.0f, 1.0f);
+  }
+}
+
+}  // namespace
 
