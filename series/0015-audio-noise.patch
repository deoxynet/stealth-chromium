+  DOMFloat32Array* array = channels_[channel_index].Get();
+  // Stealth Chromium: perturb channel data once per channel (guard bit prevents
+  // accumulation across repeated getChannelData/copyFromChannel calls).
+  if (array && channel_index < 32 &&
+      !(noise_channel_mask_ & (1u << channel_index))) {
+    const auto span = array->AsSpan();
+    ApplyAudioFingerprintNoise(span.data(), span.size());
+    noise_channel_mask_ |= (1u << channel_index);
+  }
+  return NotShared<DOMFloat32Array>(array);
 }
 
