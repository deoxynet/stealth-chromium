+namespace blink {
+
+namespace {
+
+// NVIDIA desktop/laptop models with real PCI device IDs (RTX 30 = GA10x,
+// RTX 40 = AD10x, RTX 50 = GB20x). Table lineage: ungoogled-chromium.
+struct GpuModel {
+  const char* name;
+  const char* device_id;
+};
+
+constexpr GpuModel kNvidiaGpuModels[] = {
+    {"GeForce RTX 3050", "0x00002507"},
+    {"GeForce RTX 3050", "0x00002582"},
+    {"GeForce RTX 3050 6GB Laptop GPU", "0x000025EC"},
+    {"GeForce RTX 3050 Laptop GPU", "0x000025A2"},
+    {"GeForce RTX 3050 Ti Laptop GPU", "0x000025A0"},
+    {"GeForce RTX 3060", "0x00002487"},
+    {"GeForce RTX 3060", "0x00002503"},
+    {"GeForce RTX 3060", "0x00002504"},
+    {"GeForce RTX 3060 Laptop GPU", "0x00002520"},
+    {"GeForce RTX 3060 Laptop GPU", "0x00002560"},
+    {"GeForce RTX 3060 Ti", "0x00002486"},
+    {"GeForce RTX 3060 Ti", "0x00002489"},
+    {"GeForce RTX 3060 Ti", "0x000024C9"},
+    {"GeForce RTX 3070", "0x00002484"},
+    {"GeForce RTX 3070", "0x00002488"},
+    {"GeForce RTX 3070 Ti", "0x00002482"},
+    {"GeForce RTX 3070 Ti Laptop GPU", "0x000024A0"},
+    {"GeForce RTX 3080", "0x00002206"},
+    {"GeForce RTX 3080", "0x0000220A"},
+    {"GeForce RTX 3080", "0x00002216"},
+    {"GeForce RTX 3080 Laptop GPU", "0x0000249C"},
+    {"GeForce RTX 3080 Laptop GPU", "0x000024DC"},
+    {"GeForce RTX 3080 Ti", "0x00002208"},
+    {"GeForce RTX 3080 Ti Laptop GPU", "0x00002420"},
+    {"GeForce RTX 3080 Ti Laptop GPU", "0x00002460"},
+    {"GeForce RTX 3090", "0x00002204"},
+    {"GeForce RTX 3090 Ti", "0x00002203"},
+    {"GeForce RTX 4050 Laptop GPU", "0x000028A1"},
+    {"GeForce RTX 4050 Laptop GPU", "0x000028E1"},
+    {"GeForce RTX 4060", "0x00002882"},
+    {"GeForce RTX 4060 Laptop GPU", "0x000028A0"},
+    {"GeForce RTX 4060 Laptop GPU", "0x000028E0"},
+    {"GeForce RTX 4060 Ti", "0x00002803"},
+    {"GeForce RTX 4060 Ti", "0x00002805"},
+    {"GeForce RTX 4070", "0x00002786"},
+    {"GeForce RTX 4070 Laptop GPU", "0x00002820"},
+    {"GeForce RTX 4070 Laptop GPU", "0x00002860"},
+    {"GeForce RTX 4070 SUPER", "0x00002783"},
+    {"GeForce RTX 4070 Ti", "0x00002782"},
+    {"GeForce RTX 4070 Ti SUPER", "0x00002705"},
+    {"GeForce RTX 4080", "0x00002704"},
+    {"GeForce RTX 4080 Laptop GPU", "0x000027A0"},
+    {"GeForce RTX 4080 Laptop GPU", "0x000027E0"},
+    {"GeForce RTX 4080 SUPER", "0x00002702"},
+    {"GeForce RTX 4090", "0x00002684"},
+    {"GeForce RTX 4090 Laptop GPU", "0x00002717"},
+    {"GeForce RTX 4090 Laptop GPU", "0x00002757"},
+    {"GeForce RTX 5070", "0x00002F04"},
+    {"GeForce RTX 5070 Ti", "0x00002C05"},
+    {"GeForce RTX 5070 Ti Laptop GPU", "0x00002F18"},
+    {"GeForce RTX 5070 Ti Laptop GPU", "0x00002F58"},
+    {"GeForce RTX 5080", "0x00002C02"},
+    {"GeForce RTX 5080 Laptop GPU", "0x00002C19"},
+    {"GeForce RTX 5080 Laptop GPU", "0x00002C59"},
+    {"GeForce RTX 5090", "0x00002B85"},
+    {"GeForce RTX 5090 Laptop GPU", "0x00002C18"},
+    {"GeForce RTX 5090 Laptop GPU", "0x00002C58"},
+};
+
+constexpr size_t kNvidiaGpuModelCount = std::size(kNvidiaGpuModels);
+
+// Apple SoCs for the macOS persona.
+constexpr const char* kAppleGpuModels[] = {
+    "M1", "M1 Pro", "M2", "M2 Max", "M2 Pro",
+    "M3", "M3 Max", "M3 Pro", "M4", "M4 Max", "M4 Pro",
+};
+
+constexpr char kWindowsVendorString[] = "NVIDIA";
+constexpr char kLinuxVendorString[] = "NVIDIA Corporation";
+constexpr char kLinuxGpuSuffix[] = "/PCIe/SSE2, OpenGL 4.5.0 NVIDIA 565.77";
+
+}  // namespace
+
+bool IsFingerprintGpuActive() {
+  const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+  return cmd.HasSwitch(switches::kFingerprintGpuRenderer) ||
+         cmd.HasSwitch(switches::kFingerprintGpuVendor) ||
+         cmd.HasSwitch(switches::kFingerprint);
+}
+
+std::string ResolveFingerprintGpuPlatform() {
+  const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+  if (cmd.HasSwitch(switches::kFingerprintPlatform)) {
+    const std::string value =
+        cmd.GetSwitchValueASCII(switches::kFingerprintPlatform);
+    if (base::IsStringASCII(value)) {
+      return base::ToLowerASCII(value);
+    }
+  }
+  return "linux";
+}
+
+std::string GetGLVendorStringForFingerprint() {
+  const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+  if (cmd.HasSwitch(switches::kFingerprintGpuVendor)) {
+    const std::string value =
+        cmd.GetSwitchValueASCII(switches::kFingerprintGpuVendor);
+    return base::IsStringASCII(value) ? value : std::string();
+  }
+  if (!cmd.HasSwitch(switches::kFingerprint)) {
+    return std::string();
+  }
+  const std::string platform = ResolveFingerprintGpuPlatform();
+  if (platform == "macos") {
+    return "Google Inc. (Apple)";
+  }
+  if (platform == "linux") {
+    return "Google Inc. (NVIDIA Corporation)";
+  }
+  return "Google Inc. (NVIDIA)";
+}
+
+std::string GetGLRendererStringForFingerprint() {
+  const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+  std::string value;
+  bool have_renderer = false;
+  if (cmd.HasSwitch(switches::kFingerprintGpuRenderer)) {
+    value = cmd.GetSwitchValueASCII(switches::kFingerprintGpuRenderer);
+    if (!base::IsStringASCII(value)) {
+      value.clear();
+    }
+    have_renderer = true;
+  } else if (cmd.HasSwitch(switches::kFingerprint)) {
+    value = fingerprint::SeedString();
+  } else {
+    return std::string();
+  }
+
+  const std::string platform = ResolveFingerprintGpuPlatform();
+
+  if (have_renderer) {
+    if (base::StartsWith(value, "ANGLE (")) {
+      return value;
+    }
+    if (platform == "windows" || platform == "linux") {
+      for (const GpuModel& model : kNvidiaGpuModels) {
+        if (value.find(model.name) != std::string::npos) {
+          if (platform == "linux") {
+            return "ANGLE (" + std::string(kLinuxVendorString) + ", " + value +
+                   kLinuxGpuSuffix + ")";
+          }
+          return "ANGLE (" + std::string(kWindowsVendorString) + ", " + value +
+                 " (" + model.device_id +
+                 ") Direct3D11 vs_5_0 ps_5_0, D3D11)";
+        }
+      }
+    }
+    return value;
+  }
+
+  // Seed path: deterministic index into the model database.
+  const uint32_t hash =
+      static_cast<uint32_t>(fingerprint::HashFor("gpu_renderer"));
+  if (platform == "macos") {
+    return "ANGLE (Apple, ANGLE Metal Renderer: Apple " +
+           std::string(kAppleGpuModels[hash % std::size(kAppleGpuModels)]) +
+           ", Unspecified Version)";
+  }
+  const GpuModel& model = kNvidiaGpuModels[hash % kNvidiaGpuModelCount];
+  if (platform == "linux") {
+    return "ANGLE (" + std::string(kLinuxVendorString) + ", NVIDIA " +
+           model.name + kLinuxGpuSuffix + ")";
+  }
+  // Windows persona: full ANGLE D3D11 renderer string.
+  return "ANGLE (" + std::string(kWindowsVendorString) + ", NVIDIA " +
+         model.name + " (" + model.device_id +
+         ") Direct3D11 vs_5_0 ps_5_0, D3D11)";
+}
+
+}  // namespace blink
