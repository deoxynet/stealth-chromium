+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_GPU_FINGERPRINT_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_GPU_FINGERPRINT_H_
+
+#include <string>
+
+namespace blink {
+
+// Identity-seed-driven WebGL GPU persona. When none of
+// --fingerprint-gpu-vendor / --fingerprint-gpu-renderer / --fingerprint is
+// present every getter returns the empty string and callers fall back to
+// stock GPU values.
+bool IsFingerprintGpuActive();
+
+// Lowercased --fingerprint-platform, default "linux" when absent (the
+// vendor/renderer pools pick per-OS strings).
+std::string ResolveFingerprintGpuPlatform();
+
+// UNMASKED_VENDOR_WEBGL persona; "" = no spoof.
+std::string GetGLVendorStringForFingerprint();
+
+// UNMASKED_RENDERER_WEBGL persona (ANGLE-style string derived from the
+// embedded NVIDIA model database, or an Apple SoC on the macOS persona);
+// "" = no spoof.
+std::string GetGLRendererStringForFingerprint();
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_GPU_FINGERPRINT_H_
