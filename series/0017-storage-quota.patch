+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_QUOTA_FINGERPRINT_QUOTA_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_QUOTA_FINGERPRINT_QUOTA_H_
+
+#include <algorithm>
+#include <cstdint>
+
+#include "base/command_line.h"
+#include "third_party/blink/public/common/fingerprint/fingerprint.h"
+#include "third_party/blink/public/common/switches.h"
+
+// navigator.storage quota persona. Reported quota is deterministic per
+// identity seed, uniform in [400 MiB, 600 MiB); an explicit
+// --fingerprint-storage-quota=<MiB> wins. Real usage is never altered.
+namespace blink::fingerprint {
+
+inline int64_t NormalizeQuotaForFingerprint() {
+  if (!Enabled()) {
+    return 0;
+  }
+  if (auto mib = SwitchUint(switches::kFingerprintStorageQuota)) {
+    if (*mib > 0) {
+      return static_cast<int64_t>(*mib) << 20;
+    }
+  }
+  if (!Seed()) {
+    return 0;
+  }
+  const double jitter = RandomFor("storagequota") * 209715200.0;  // 200 MiB
+  return (int64_t{400} << 20) + static_cast<int64_t>(jitter);
+}
+
+// Vendor rule: spoof only when the real quota is large (>1 GiB, i.e. a real
+// disk-backed pool) or an explicit switch was passed; never report a quota
+// below actual usage.
+inline int64_t ApplyQuotaPersona(int64_t real_quota, int64_t usage) {
+  const int64_t spoof = NormalizeQuotaForFingerprint();
+  const bool explicit_switch = Enabled() && base::CommandLine::ForCurrentProcess()
+      ->HasSwitch(switches::kFingerprintStorageQuota);
+  if (spoof > 0 && (real_quota > (int64_t{1} << 30) || explicit_switch)) {
+    return std::max(usage, spoof);
+  }
+  return real_quota;
+}
+
+}  // namespace blink::fingerprint
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_QUOTA_FINGERPRINT_QUOTA_H_
