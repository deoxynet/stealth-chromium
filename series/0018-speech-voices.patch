From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stealth Chromium contributors
Date: Thu, 1 Jan 2026 00:00:00 +0000
Subject: [PATCH 18/33] fingerprint: per-persona speechSynthesis voice lists
X-Spec: patches/32-speech-synthesis-voices.md
X-Files: third_party/blink/renderer/modules/speech/speech_synthesis.cc

---

--- a/third_party/blink/renderer/modules/speech/speech_synthesis.cc
+++ b/third_party/blink/renderer/modules/speech/speech_synthesis.cc
@@ -25,9 +25,11 @@
 
 #include "third_party/blink/renderer/modules/speech/speech_synthesis.h"
 
+
 #include <tuple>
 
 #include "build/build_config.h"
+#include "third_party/blink/public/common/fingerprint/fingerprint.h"
 #include "third_party/blink/public/common/thread_safe_browser_interface_broker_proxy.h"
 #include "third_party/blink/public/platform/browser_interface_broker_proxy.h"
 #include "third_party/blink/public/platform/platform.h"
@@ -88,6 +90,60 @@
 void SpeechSynthesis::OnSetVoiceList(
     Vector<mojom::blink::SpeechSynthesisVoicePtr> mojom_voices) {
   voice_list_.clear();
+
+  // Stealth Chromium: replace the host's real TTS voices with the persona's
+  // table (matching what stock Chrome reports on that OS). Not seed-
+  // randomized: every session of a persona reports the same voice list.
+  // speechSynthesis.speak still routes to the real backend.
+  const fingerprint::Platform persona = fingerprint::SpoofedPlatform();
+  if (persona != fingerprint::Platform::kNone &&
+      persona != fingerprint::Platform::kLinux) {
+    struct PersonaVoice {
+      const char* name;
+      const char* lang;
+      bool local_service;
+      bool is_default;
+    };
+    // Tables copied from real Chrome installs (vendor spec, patch 32).
+    static constexpr PersonaVoice kWindowsVoices[] = {
+        {"Microsoft David - English (United States)", "en-US", true, true},
+        {"Microsoft Zira - English (United States)", "en-US", true, false},
+        {"Microsoft Mark - English (United States)", "en-US", true, false},
+        {"Google US English", "en-US", false, false},
+        {"Google UK English Female", "en-GB", false, false},
+        {"Google UK English Male", "en-GB", false, false},
+    };
+    static constexpr PersonaVoice kMacVoices[] = {
+        {"Samantha", "en-US", true, true},
+        {"Alex", "en-US", true, false},
+        {"Victoria", "en-US", true, false},
+        {"Fred", "en-US", true, false},
+        {"Daniel", "en-GB", true, false},
+        {"Serena", "en-GB", true, false},
+        {"Google US English", "en-US", false, false},
+        {"Google UK English Female", "en-GB", false, false},
+        {"Google UK English Male", "en-GB", false, false},
+    };
+    const PersonaVoice* voices = persona == fingerprint::Platform::kWindows
+                                     ? kWindowsVoices
+                                     : kMacVoices;
+    const size_t count = persona == fingerprint::Platform::kWindows
+                             ? std::size(kWindowsVoices)
+                             : std::size(kMacVoices);
+    for (size_t i = 0; i < count; ++i) {
+      auto mojom_voice = mojom::blink::SpeechSynthesisVoice::New();
+      mojom_voice->voice_uri = voices[i].name;
+      mojom_voice->name = voices[i].name;
+      mojom_voice->lang = voices[i].lang;
+      mojom_voice->is_local_service = voices[i].local_service;
+      mojom_voice->is_default = voices[i].is_default;
+      voice_list_.push_back(MakeGarbageCollected<SpeechSynthesisVoice>(
+          std::move(mojom_voice)));
+    }
+    VoicesDidChange();
+    return;
+  }
+
   for (auto& mojom_voice : mojom_voices) {
     voice_list_.push_back(
         MakeGarbageCollected<SpeechSynthesisVoice>(std::move(mojom_voice)));
