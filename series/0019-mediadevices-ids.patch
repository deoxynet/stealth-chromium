 namespace {
 
+// Stealth Chromium: 16 lowercase hex chars from the identity-seed hash of
+// |purpose| — mirrors the vendor's HexEncodeLower(hash64(seed + suffix)).
+std::string FingerprintMediaId(const std::string& purpose) {
+  const uint64_t hash = blink::fingerprint::HashFor(purpose);
+  char hex[17];
+  static const char kHexDigits[] = "0123456789abcdef";
+  for (int k = 0; k < 16; ++k) {
+    hex[k] = kHexDigits[(hash >> ((15 - k) * 4)) & 0xF];
+  }
+  hex[16] = '\0';
+  return std::string(hex);
+}
+
+}  // namespace
