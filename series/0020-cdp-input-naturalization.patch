@@ -126,9 +129,22 @@
 base::TimeTicks GetEventTimeTicks(const std::optional<double>& timestamp) {
   // Convert timestamp, in seconds since unix epoch, to an event timestamp
   // which is time ticks since platform start time.
-  return timestamp.has_value()
-             ? base::Seconds(timestamp.value()) + base::TimeTicks::UnixEpoch()
-             : base::TimeTicks::Now();
+  if (timestamp.has_value()) {
+    return base::Seconds(timestamp.value()) + base::TimeTicks::UnixEpoch();
+  }
+  base::TimeTicks now = base::TimeTicks::Now();
+  // Stealth Chromium: untimed CDP input carries the exact dispatch instant; real
+  // OS input never does. Skew each event by a fresh 0..2999 µs (LCG over
+  // the tick value itself, vendor constants) so event.timeStamp looks
+  // organic. Explicit CDP timestamps pass through untouched.
+  if (blink::fingerprint::Enabled()) {
+    const int64_t ticks = now.ToInternalValue();
+    uint32_t hash = static_cast<uint32_t>(ticks >> 32) ^
+                    static_cast<uint32_t>(ticks);
+    hash = hash * 0x19660D + 0x3C6EF35F;
+    return now + base::Microseconds(hash % 3000);
+  }
+  return now;
 }
 
 bool SetKeyboardEventText(
@@ -451,7 +467,16 @@
   mouse_event->button = event_button;
   mouse_event->click_count = click_count.value_or(0);
   mouse_event->pointer_type = GetPointerType(pointer_type.value_or(""));
-  mouse_event->force = force.value_or(0);
+  mouse_event->force =
+      force.has_value()
+          ? static_cast<float>(force.value())
+          // Stealth Chromium: real OS mouse events keep the NaN default of
+          // WebPointerProperties::force; stock CDP forced 0.0, making
+          // pressure/force JS-visible behavior differ between real and
+          // synthetic input.
+          : blink::fingerprint::Enabled()
+                ? std::numeric_limits<float>::quiet_NaN()
+                : 0;
   mouse_event->tangential_pressure = tangential_pressure.value_or(0);
   mouse_event->tilt_x = tilt_x.value_or(0);
   mouse_event->tilt_y = tilt_y.value_or(0);
@@ -1207,6 +1232,18 @@
   if (key.has_value()) {
     event.dom_key =
         static_cast<int>(ui::KeycodeConverter::KeyStringToDomKey(key.value()));
+  }
+
+  // Stealth Chromium: CDP callers commonly omit `code`; stock leaves dom_code =
+  // NONE (event.code == "" in the page — a synthetic-input tell). Derive
+  // the US-layout DomCode implied by `key`, as a real key press would.
+  if (!code.has_value() && key.has_value() &&
+      blink::fingerprint::Enabled()) {
+    const ui::DomCode derived_code = ui::UsLayoutDomKeyToDomCode(
+        ui::KeycodeConverter::KeyStringToDomKey(key.value()));
+    if (derived_code != ui::DomCode::NONE) {
+      event.dom_code = static_cast<int>(derived_code);
+    }
   }
 
