+// fp-patches: CDP-injected mouse moves (kFromDebugger set) reach the
+// renderer with an empty coalesced vector, while real OS input carries
+// coalesced samples. Synthesize a 3–5 sample stream between the previous
+// and current position — ±0.15 px per-axis jitter, interpolated
+// coordinates, timestamps spaced 16 µs apart — deterministic per identity
+// seed. Constants follow the vendor build (spec
+// patches/33-pointer-event-input-stealth.md); LCG stream seeding is
+// reconstructed, per-seed determinism is what matters.
+Vector<WebPointerEvent> SynthesizeCoalescedEvents(
+    const WebPointerEvent& event,
+    const gfx::PointF& previous_screen_position) {
+  Vector<WebPointerEvent> samples;
+
+  const gfx::PointF current = event.PositionInScreen();
+  const float delta_x = current.x() - previous_screen_position.x();
+  const float delta_y = current.y() - previous_screen_position.y();
+
+  const uint32_t hash = static_cast<uint32_t>(
+      blink::fingerprint::HashFor("coalesced"));
+  // Y axis chosen for the seed mix (axis INFERRED in the spec).
+  uint32_t state =
+      static_cast<uint32_t>(static_cast<int32_t>(1000.f * delta_y)) ^ hash;
+  state = state * 0x19660D + 0x3C6EF35F;
+  const int denominator = static_cast<int>(state % 3) + 3;
+  state = state * 0x19660D + 0x3C6EF35F;
+  const int count = static_cast<int>(state % 3) + 3;
+
+  // Two parallel 32-bit LCG streams (the vendor pairs) for x/y jitter.
+  uint32_t jitter_x_state = state;
+  uint32_t jitter_y_state = hash * 0x17385CA9 + 0x47502932;
+
+  const base::TimeTicks end = event.TimeStamp();
+  for (int i = 0; i < count; ++i) {
+    const float t = static_cast<float>(i + 1) / denominator;
+    jitter_x_state = jitter_x_state * 0x19660D + 0x3C6EF35F;
+    jitter_y_state = jitter_y_state * 0x17385CA9 + 0x47502932;
+    const float jitter_x =
+        ((jitter_x_state >> 16) / 65536.f - 0.5f) * 0.3f;
+    const float jitter_y =
+        ((jitter_y_state >> 16) / 65536.f - 0.5f) * 0.3f;
+
+    WebPointerEvent sample = event;
+    // Scrub the CDP marker so the synthesized stream matches the parent.
+    sample.SetModifiers(event.GetModifiers() &
+                        ~WebInputEvent::kFromDebugger);
+    const gfx::PointF screen_pos(previous_screen_position.x() +
+                                     delta_x * t + jitter_x,
+                                 previous_screen_position.y() +
+                                     delta_y * t + jitter_y);
+    sample.SetPositionInScreen(screen_pos);
+    // Keep the widget pair consistent with the interpolated screen pair
+    // (CDP input sets screen := widget, so both share the same offset).
+    sample.SetPositionInWidget(
+        gfx::PointF(event.PositionInWidget().x() +
+                        (screen_pos.x() - current.x()),
+                    event.PositionInWidget().y() +
+                        (screen_pos.y() - current.y())));
+    // Monotonic timestamps >= 16 µs apart ending just before the parent
+    // event; with count <= 5 the vendor's 2 ms look-back clamp never binds.
+    sample.SetTimeStamp(end - base::Microseconds((count - i) * 16));
+    samples.push_back(sample);
+  }
+  return samples;
+}
