+// fp-patches: per-platform font databases for font platform spoofing
+// (spec patches/18-fonts.md). The three name lists are the vendor build's
+// recovered font inventories (patches/refs/font-databases.txt), kept
+// verbatim: they encode what a real Windows / macOS / Linux box has
+// installed, so availability decisions match the spoofed OS. Families that
+// exist only on the host OS are reported unavailable; Windows-only
+// families are re-aimed at metric-compatible local fonts.
+namespace blink::fingerprint_fonts {
+
+// The host OS this binary runs on, in the same vocabulary as
+// fingerprint::SpoofedPlatform(). kNone on platforms without a desktop-OS
+// persona (the spoof then applies without a host filter).
+inline fingerprint::Platform CurrentBuildPlatform() {
+#if BUILDFLAG(IS_WIN)
+  return fingerprint::Platform::kWindows;
+#elif BUILDFLAG(IS_MAC)
+  return fingerprint::Platform::kMacOs;
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+  return fingerprint::Platform::kLinux;
+#else
+  return fingerprint::Platform::kNone;
+#endif
+}
+
+// Builds a lowercase-name set — mirrors the vendor's BuildLowercaseSet()
+// helper over initializer_list<const char*>.
+inline std::set<std::string> BuildLowercaseSet(
+    std::initializer_list<const char*> names) {
+  std::set<std::string> set;
+  for (const char* name : names) {
+    set.insert(base::ToLowerASCII(name));
+  }
+  return set;
+}
