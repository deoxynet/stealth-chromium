+// Families provided as real font files under --fingerprint-fonts-dir
+// (convention: "<Family>.ttf" / ".otf" / ".ttc", basename = family name).
+// Scanned once; the directory acts as an extension of the spoofed
+// platform's database, so user-shipped persona fonts report available.
+// For real metrics the directory must also be fontconfig-visible (e.g.
+// symlinked into ~/.fonts); family matching here only decides
+// availability, since FontFaceCreationParams at 146 has no create-from-
+// file path (kCreateFontByFciIdAndTtcIndex is fontconfig-internal).
+inline bool FontsDirProvides(const std::string& lowercase_family) {
+  static const base::NoDestructor<const std::set<std::string>> kProvided = [] {
+    std::set<std::string> families;
+    const std::string dir = base::CommandLine::ForCurrentProcess()
+                                ->GetSwitchValueASCII(
+                                    switches::kFingerprintFontsDir);
+    if (dir.empty()) {
+      return families;
+    }
+    base::FileEnumerator enumerator(base::FilePath::FromUTF8Unsafe(dir),
+                                     /*recursive=*/false,
+                                     base::FileEnumerator::FILES);
+    for (base::FilePath path = enumerator.Next(); !path.empty();
+         path = enumerator.Next()) {
+      std::string name = path.BaseName().RemoveExtension().AsUTF8Unsafe();
+      if (!name.empty()) {
+        families.insert(base::ToLowerASCII(name));
+      }
+    }
+    return families;
+  }();
+  return kProvided->count(lowercase_family) > 0;
+}
+
+// Decision for a family-based font lookup under an active persona.
+enum class FontLookupDecision {
+  kStock,        // fingerprinting off, no persona, or non-family lookup
+  kUnavailable,  // family exists on the host OS but not on the spoofed OS
+  kProceed,      // available or unknown everywhere; |out_params| may be
+                 // rewritten to a metric-compatible local family
+};
+
+// Core hook helper for FontCache::GetFontPlatformData. Availability is
+// decided on the requested family name (Windows aliasing happens after,
+// on the proceed path — aliasing first would misclassify the aliased
+// local name as host-only).
+inline FontLookupDecision ResolveSpoofedFamily(
+    const FontFaceCreationParams& creation_params,
+    FontFaceCreationParams& out_params) {
+  if (!fingerprint::Enabled() ||
+      creation_params.CreationType() != kCreateFontByFamily) {
+    return FontLookupDecision::kStock;
+  }
+  const fingerprint::Platform spoofed = fingerprint::SpoofedPlatform();
+  const fingerprint::Platform current = CurrentBuildPlatform();
+  if (spoofed == fingerprint::Platform::kNone || spoofed == current) {
+    // Vendor gate: is_cross_platform = !(spoofed_platform == current_os).
+    return FontLookupDecision::kStock;
+  }
+
+  const std::string family =
+      base::ToLowerASCII(creation_params.Family().Utf8());
+  if (IsBasicFont(family)) {
+    return FontLookupDecision::kProceed;
+  }
+
+  const bool known_on_spoofed =
+      GetPlatformFonts(spoofed).count(family) > 0 || FontsDirProvides(family);
+  if (!known_on_spoofed &&
+      GetPlatformFonts(current).count(family) > 0) {
+    // Host-only family: report it as unavailable, as the spoofed OS would.
+    return FontLookupDecision::kUnavailable;
+  }
+
+  if (spoofed == fingerprint::Platform::kWindows) {
+    const auto it = WindowsAliases().find(family);
+    if (it != WindowsAliases().end()) {
+      // Intern the substituted name so subsequent matching uses it.
+      out_params = FontFaceCreationParams(
+          AtomicString(String::FromUTF8(it->second)));
+    }
+  }
+  return FontLookupDecision::kProceed;
+}
