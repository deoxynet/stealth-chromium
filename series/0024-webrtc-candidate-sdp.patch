 }
 
+// fp-patches: the --fingerprint-webrtc-ip replacement IP, or "" when the
+// WebRTC IP spoof is inactive (fingerprinting off, switch absent, empty
+// value) or the value is not pure ASCII — vendor semantics discard a
+// non-ASCII value rather than rewrite with it. Re-read independently by the
+// SDP (rtc_peer_connection_handler.cc) and getStats (rtc_stats_report.cc)
+// spoofs; keep the three readers' value semantics identical.
+std::string FingerprintWebrtcIpSpoof() {
+  if (!fingerprint::Enabled()) {
+    return std::string();
+  }
+  const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+  if (!cmd.HasSwitch(switches::kFingerprintWebrtcIp)) {
+    return std::string();
+  }
+  const std::string value =
+      cmd.GetSwitchValueNative(switches::kFingerprintWebrtcIp);
+  if (!base::IsStringASCII(value)) {
+    return std::string();
+  }
+  return value;
+}
+
+// fp-patches: host strings never rewritten (loopback/wildcard stay honest so
+// exempt candidates cannot disagree between the candidate object, SDP and
+// getStats()).
+bool IsExemptWebrtcHost(const std::string& host) {
+  return host.empty() || host == "0.0.0.0" || host == "127.0.0.1";
+}
+
 }  // namespace
 
 RTCIceCandidatePlatform::RTCIceCandidatePlatform(
@@ -62,6 +98,9 @@
     return;
   }
 
+  // fp-patches: replacement IP for every host string this candidate exposes.
+  const std::string spoof = FingerprintWebrtcIpSpoof();
+
   const webrtc::Candidate& c = parsed_candidate.value();
 
   foundation_ = String::FromUTF8(c.foundation());
@@ -70,6 +109,11 @@
   protocol_ = String::FromUTF8(c.protocol());
   if (!c.address().IsNil()) {
     address_ = String::FromUTF8(c.address().HostAsURIString());
+    // fp-patches: swap in the spoofed IP; the port is kept as gathered.
+    if (!spoof.empty() &&
+        !IsExemptWebrtcHost(c.address().HostAsURIString())) {
+      address_ = String::FromUTF8(spoof);
+    }
     port_ = c.address().port();
   }
   // The `type_name()` property returns a name as specified in:
@@ -85,12 +129,46 @@
   }
   if (!c.related_address().IsNil()) {
     related_address_ = String::FromUTF8(c.related_address().HostAsURIString());
+    // fp-patches: same substitution + exemption rule as |address_|; the
+    // related port is kept as gathered.
+    if (!spoof.empty() &&
+        !IsExemptWebrtcHost(c.related_address().HostAsURIString())) {
+      related_address_ = String::FromUTF8(spoof);
+    }
     related_port_ = c.related_address().port();
   }
   // url_ is set only when the candidate was gathered locally.
   if (type_ == "relay" && priority_ && !url_.IsNull()) {
     relay_protocol_ = PriorityToRelayProtocol(*priority_);
   }
+
+  // fp-patches: rebuild the raw candidate string around the spoofed
+  // connection address. The address is the 5th space-separated token
+  // (index 4 — "candidate:<foundation>" counts as one token) and the token
+  // following a literal "raddr" token is the related address; both carry
+  // the empty/0.0.0.0/127.0.0.1 exemption. Rebuilding from |candidate_|
+  // (not the parsed candidate) also rewrites fields the parser normalized.
+  if (!spoof.empty()) {
+    std::istringstream tokens(candidate_.Utf8());
+    std::string rebuilt;
+    std::string token;
+    int index = 0;
+    bool substitute = false;
+    while (tokens >> token) {
+      if (!rebuilt.empty()) {
+        rebuilt += ' ';
+      }
+      const bool next_follows_raddr = (token == "raddr");
+      if ((index == 4 || substitute) && !IsExemptWebrtcHost(token)) {
+        rebuilt += spoof;
+      } else {
+        rebuilt += token;
+      }
+      ++index;
+      substitute = next_follows_raddr;
+    }
+    candidate_ = String::FromUTF8(rebuilt);
+  }
 }
 
 }  // namespace blink
