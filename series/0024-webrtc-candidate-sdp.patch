 enum class RtcpMux { kDisabled, kEnabled, kNoMedia, kMax };
 
+// fp-patches: rewrite the IP-bearing SDP lines of |sdp| to the
+// --fingerprint-webrtc-ip value. Returns |sdp| unchanged when the spoof is
+// inactive (fingerprinting off, switch absent/empty, non-ASCII value).
+// Semantics (spec patches/22-webrtc-candidate-sdp.md):
+// - "o=" lines: the "IN IP4 " (or "IN IP6 ") addrtype+address tail is
+//   replaced; IPv6 lines are converted to the IPv4 form with the spoof.
+// - "c=IN IP4 "/"c=IN IP6 " lines: become "c=IN IP4 <spoof>".
+// - "a=candidate:" lines: re-tokenized; the connection address (token
+//   index 4) and the token after a literal "raddr" token are replaced —
+//   deliberately without the 0.0.0.0/127.0.0.1 exemption the
+//   RTCIceCandidatePlatform object fields keep (vendor asymmetry).
+// - every other line passes through; output is CRLF-terminated.
+std::string MaybeSpoofSdpAddresses(const std::string& sdp) {
+  std::string spoof;
+  if (fingerprint::Enabled() &&
+      base::CommandLine::ForCurrentProcess()->HasSwitch(
+          switches::kFingerprintWebrtcIp)) {
+    const std::string value = base::CommandLine::ForCurrentProcess()
+                                  ->GetSwitchValueNative(
+                                      switches::kFingerprintWebrtcIp);
+    if (base::IsStringASCII(value)) {
+      spoof = value;
+    }
+  }
+  if (spoof.empty()) {
+    return sdp;
+  }
+
+  std::istringstream lines(sdp);
+  std::string rebuilt;
+  std::string line;
+  while (std::getline(lines, line, '\n')) {
+    if (!line.empty() && line.back() == '\r') {
+      line.pop_back();
+    }
+    if (line.rfind("o=", 0) == 0) {
+      const size_t ip4 = line.find("IN IP4 ");
+      const size_t ip6 = line.find("IN IP6 ");
+      if (ip4 != std::string::npos) {
+        line = line.substr(0, ip4 + 7) + spoof;
+      } else if (ip6 != std::string::npos) {
+        line = line.substr(0, ip6) + "IN IP4 " + spoof;
+      }
+    } else if (line.rfind("c=IN IP4 ", 0) == 0 ||
+               line.rfind("c=IN IP6 ", 0) == 0) {
+      line = "c=IN IP4 " + spoof;
+    } else if (line.rfind("a=candidate:", 0) == 0) {
+      std::istringstream tokens(line.substr(12));
+      std::string out;
+      std::string token;
+      int index = 0;
+      bool substitute = false;
+      while (tokens >> token) {
+        if (!out.empty()) {
+          out += ' ';
+        }
+        if (index == 4 || substitute) {
+          out += spoof;
+        } else {
+          out += token;
+        }
+        ++index;
+        substitute = (token == "raddr");
+      }
+      line = "a=candidate:" + out;
+    }
+    rebuilt += line;
+    rebuilt += "\r\n";
+  }
+  return rebuilt;
+}
+
 RTCSessionDescriptionPlatform* CreateWebKitSessionDescription(
     const std::string& sdp,
     const std::string& type) {
@@ -114,6 +191,10 @@
     return nullptr;
   }
 
+  // fp-patches: rewrite IP-bearing lines before the SDP becomes JS-visible
+  // (RTCPeerConnection.{local,remote,current,pending}Description).
+  sdp = MaybeSpoofSdpAddresses(sdp);
+
   return CreateWebKitSessionDescription(sdp, native_desc->type());
