+
+// fp-patches: substitute the --fingerprint-webrtc-ip value for candidate
+// stat addresses. Passes the input through when the spoof is inactive
+// (fingerprinting off, switch absent, empty or non-ASCII value) or the
+// input is empty/loopback/wildcard — the same exemption set as the ICE
+// candidate (rtc_ice_candidate_platform.cc) and SDP
+// (rtc_peer_connection_handler.cc) rewrites, so getStats() never disagrees
+// with onicecandidate/localDescription for those.
+String MaybeSpoofStatsAddress(const std::string& input) {
+  const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+  if (!fingerprint::Enabled() ||
+      !cmd.HasSwitch(switches::kFingerprintWebrtcIp)) {
+    return String::FromUTF8(input);
+  }
+  const std::string spoof =
+      cmd.GetSwitchValueNative(switches::kFingerprintWebrtcIp);
+  if (!base::IsStringASCII(spoof) || spoof.empty() || input.empty() ||
+      input == "0.0.0.0" || input == "127.0.0.1") {
+    return String::FromUTF8(input);
+  }
+  return String::FromUTF8(spoof);
 }
 
