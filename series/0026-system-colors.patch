+namespace {
+
+// Stealth Chromium: gate for the Windows CSS-system-color persona (spec
+// patches/27-system-colors.md): --fingerprint must be present and not an
+// off-value, and --fingerprint-platform must be "windows". ui/ cannot
+// include the blink fingerprint core, so the switch names and off-value
+// semantics are repeated here from
+// third_party/blink/public/common/fingerprint/fingerprint.h.
+bool ShouldSpoofWindowsSystemColors() {
+  static const bool spoof = [] {
+    const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+    if (!cmd.HasSwitch("fingerprint")) {
+      return false;
+    }
+    const std::string value =
+        base::ToLowerASCII(cmd.GetSwitchValueASCII("fingerprint"));
+    if (value == "off" || value == "false" || value == "0" ||
+        value == "disable" || value == "disabled") {
+      return false;
+    }
+    return base::ToLowerASCII(cmd.GetSwitchValueASCII(
+               "fingerprint-platform")) == "windows";
+  }();
+  return spoof;
 }
 
+}  // namespace
+
 void CompleteDefaultCssSystemColorDefinition(ui::ColorMixer& mixer,
                                              bool dark_mode) {
+  // Stealth Chromium: Windows persona — define the default CSS system colors from
+  // the hardcoded Windows 10/11 default palette instead of the
+  // cross-platform defaults, so the ColorProvider path agrees with the
+  // LayoutTheme::SystemColor hook and a non-Windows host cannot leak its
+  // platform palette. Values are reconstructed from the public Windows
+  // defaults (the vendor binary's exact constants were not recovered).
+  if (ShouldSpoofWindowsSystemColors()) {
+    mixer[kColorCssSystemActiveText] = {SkColorSetRGB(0xFF, 0x00, 0x00)};
+    mixer[kColorCssSystemGrayText] =
+        {dark_mode ? SkColorSetRGB(0xA6, 0xA6, 0xA6)
+                   : SkColorSetRGB(0x6D, 0x6D, 0x6D)};
+    // Win10/11 default accent (COLOR_HIGHLIGHT); theme-independent.
+    mixer[kColorCssSystemHighlight] = {SkColorSetRGB(0x00, 0x78, 0xD7)};
+    mixer[kColorCssSystemHighlightText] = {SK_ColorWHITE};
+    if (dark_mode) {
+      mixer[kColorCssSystemBtnFace] = {SkColorSetRGB(0x6B, 0x6B, 0x6B)};
+      mixer[kColorCssSystemBtnText] = {SK_ColorWHITE};
+      mixer[kColorCssSystemField] = {SkColorSetRGB(0x3B, 0x3B, 0x3B)};
+      mixer[kColorCssSystemFieldText] = {SK_ColorWHITE};
+      mixer[kColorCssSystemMenuHilight] = {SkColorSetRGB(0x80, 0x00, 0x80)};
+      mixer[kColorCssSystemScrollbar] = {SkColorSetRGB(0x12, 0x12, 0x12)};
+      mixer[kColorCssSystemWindow] = {SkColorSetRGB(0x12, 0x12, 0x12)};
+      mixer[kColorCssSystemWindowText] = {SK_ColorWHITE};
+      mixer[kColorCssSystemHotlight] = {SkColorSetRGB(0x9E, 0x9E, 0xFF)};
+      mixer[kColorCssSystemLinkText] = {SkColorSetRGB(0x9E, 0x9E, 0xFF)};
+      mixer[kColorCssSystemVisitedText] = {SkColorSetRGB(0xD0, 0xAD, 0xF0)};
+    } else {
+      mixer[kColorCssSystemBtnFace] = {SkColorSetRGB(0xF0, 0xF0, 0xF0)};
+      mixer[kColorCssSystemBtnText] = {SK_ColorBLACK};
+      mixer[kColorCssSystemField] = {SK_ColorWHITE};
+      mixer[kColorCssSystemFieldText] = {SK_ColorBLACK};
+      // Win10 COLOR_MENUHILIGHT.
+      mixer[kColorCssSystemMenuHilight] = {SkColorSetRGB(0x33, 0x99, 0xFF)};
+      // Win10 COLOR_SCROLLBAR.
+      mixer[kColorCssSystemScrollbar] = {SkColorSetRGB(0xF0, 0xF0, 0xF0)};
+      mixer[kColorCssSystemWindow] = {SK_ColorWHITE};
+      mixer[kColorCssSystemWindowText] = {SK_ColorBLACK};
+      // Win10 COLOR_HOTLIGHT; Windows maps link text onto it.
+      mixer[kColorCssSystemHotlight] = {SkColorSetRGB(0x00, 0x66, 0xCC)};
+      mixer[kColorCssSystemLinkText] = {SkColorSetRGB(0x00, 0x66, 0xCC)};
+      mixer[kColorCssSystemVisitedText] = {SkColorSetRGB(0x55, 0x1A, 0x8B)};
+    }
+    return;
+  }
   mixer[kColorCssSystemActiveText] = {SkColorSetRGB(0xFF, 0x00, 0x00)};
   mixer[kColorCssSystemGrayText] = {SkColorSetRGB(0x80, 0x80, 0x80)};
   mixer[kColorCssSystemHighlight] = {SkColorSetRGB(0x19, 0x67, 0xD2)};
