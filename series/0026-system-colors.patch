+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FINGERPRINT_WINDOWS_SYSTEM_COLORS_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FINGERPRINT_WINDOWS_SYSTEM_COLORS_H_
+
+// Stealth Chromium: Windows-persona palette for the CSS system color keywords.
+//
+// Serves hardcoded Windows-default colors so that a Chromium build running
+// on a non-Windows host never leaks the host palette (GTK on Linux, Aqua on
+// macOS) through CSS system colors (`getComputedStyle`, UA rendering).
+// Reimplementation of the vendor build's LayoutTheme::SystemColor jump
+// table (spec patches/27-system-colors.md). The vendor's exact per-keyword
+// constants were not recovered from the binary; the values below are a
+// representative table reconstructed from the public Windows 10/11 default
+// system palette (light) and from Chromium's documented dark defaults for
+// keywords where Windows has no distinct dark-mode syscolor. Determinism is
+// what matters, not bit-parity with any other build.
+
+#include <optional>
+
+#include "third_party/blink/renderer/core/css_value_keywords.h"
+#include "third_party/blink/renderer/platform/graphics/color.h"
+
+namespace blink::fingerprint {
+
+// Returns the Windows-persona color for a CSS system color keyword, or
+// nullopt for keywords that are not spoofed (internal ids fall back to the
+// stock LayoutTheme paths).
+inline std::optional<Color> WindowsSystemColor(CSSValueID css_value_id,
+                                               bool dark_scheme) {
+  switch (css_value_id) {
+    // No public Windows syscolor; Windows Chromium reports Chromium's own
+    // constants for these, so the persona must not diverge from them.
+    case CSSValueID::kActivetext:
+      return Color(0xFF, 0x00, 0x00);
+    case CSSValueID::kMark:
+      return Color(0xFF, 0xFF, 0x00);
+    case CSSValueID::kMarktext:
+      return Color::kBlack;
+    case CSSValueID::kVisitedtext:
+      return dark_scheme ? Color(0xD0, 0xAD, 0xF0) : Color(0x55, 0x1A, 0x8B);
+
+    // Default Windows accent color (also COLOR_HIGHLIGHT on 10/11).
+    case CSSValueID::kAccentcolor:
+      return Color(0x00, 0x78, 0xD7);
+    case CSSValueID::kAccentcolortext:
+      // The accent is dark in both schemes, so text on it is white.
+      return Color::kWhite;
+
+    case CSSValueID::kButtonborder:
+    // The following system colors were deprecated to default to ButtonBorder.
+    case CSSValueID::kActiveborder:
+    case CSSValueID::kInactiveborder:
+    case CSSValueID::kThreeddarkshadow:
+    case CSSValueID::kThreedhighlight:
+    case CSSValueID::kThreedlightshadow:
+    case CSSValueID::kThreedshadow:
+    case CSSValueID::kWindowframe:
+      return dark_scheme ? Color(0x6B, 0x6B, 0x6B)
+                         : Color(0x64, 0x64, 0x64);  // Win10 WindowFrame.
+    case CSSValueID::kButtonface:
+    // The following system colors were deprecated to default to ButtonFace.
+    case CSSValueID::kButtonhighlight:
+    case CSSValueID::kButtonshadow:
+    case CSSValueID::kThreedface:
+      return dark_scheme ? Color(0x6B, 0x6B, 0x6B)
+                         : Color(0xF0, 0xF0, 0xF0);  // Win10 COLOR_3DFACE.
+    case CSSValueID::kButtontext:
+      return dark_scheme ? Color::kWhite : Color::kBlack;
+
+    case CSSValueID::kCanvas:
+    // The following system colors were deprecated to default to Canvas.
+    case CSSValueID::kAppworkspace:
+    case CSSValueID::kBackground:
+    case CSSValueID::kInactivecaption:
+    case CSSValueID::kInfobackground:
+    case CSSValueID::kMenu:
+    case CSSValueID::kWindow:
+      return dark_scheme ? Color(0x12, 0x12, 0x12) : Color::kWhite;
+    case CSSValueID::kScrollbar:
+      // Win10 COLOR_SCROLLBAR differs from Window in the light scheme.
+      return dark_scheme ? Color(0x12, 0x12, 0x12) : Color(0xF0, 0xF0, 0xF0);
+    case CSSValueID::kCanvastext:
+    // The following system colors were deprecated to default to CanvasText.
+    case CSSValueID::kActivecaption:
+    case CSSValueID::kCaptiontext:
+    case CSSValueID::kInfotext:
+    case CSSValueID::kMenutext:
+    case CSSValueID::kWindowtext:
+      return dark_scheme ? Color::kWhite : Color::kBlack;
+
+    case CSSValueID::kField:
+      return dark_scheme ? Color(0x3B, 0x3B, 0x3B) : Color::kWhite;
+    case CSSValueID::kFieldtext:
+    case CSSValueID::kText:
+      return dark_scheme ? Color::kWhite : Color::kBlack;
+
+    case CSSValueID::kGraytext:
+    // Deprecated to default to GrayText.
+    case CSSValueID::kInactivecaptiontext:
+      return dark_scheme ? Color(0xA6, 0xA6, 0xA6)
+                         : Color(0x6D, 0x6D, 0x6D);  // Win10 COLOR_GRAYTEXT.
+
+    // Win10/11 default accent; the OS accent does not change with theme.
+    case CSSValueID::kHighlight:
+    case CSSValueID::kSelecteditem:
+      return Color(0x00, 0x78, 0xD7);
+    case CSSValueID::kHighlighttext:
+    case CSSValueID::kSelecteditemtext:
+      return Color::kWhite;
+
+    case CSSValueID::kLinktext:
+      // Windows maps link text onto COLOR_HOTLIGHT.
+      return dark_scheme ? Color(0x9E, 0x9E, 0xFF)
+                         : Color(0x00, 0x66, 0xCC);
+
+    default:
+      return std::nullopt;
+  }
+}
+
+}  // namespace blink::fingerprint
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_FINGERPRINT_WINDOWS_SYSTEM_COLORS_H_
