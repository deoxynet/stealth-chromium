+
+// fp-patches: seed-derived window origin inside the spoofed screen (spec
+// patches/31-window-position-outer-size.md). The vendor build hashed
+// seed + "screenX"/"screenY" into the band left by fixed margins around
+// the screen edges (50px horizontal, 30px vertical) after subtracting the
+// outer size, so the window can never be reported outside the spoofed
+// (patch 0007) screen; HashFor provides the same per-identity determinism
+// with our stable hash. A degenerate range (window at least as large as
+// the screen minus the margin) reports the vendor's fixed fallback of 10.
+int FingerprintWindowOrigin(const LocalDOMWindow& window, bool y_axis) {
+  // The Screen accessor is non-const only because it lazily creates the
+  // window's Screen; reading it from these const getters is safe.
+  Screen* screen = const_cast<LocalDOMWindow&>(window).screen();
+  const int margin = y_axis ? 30 : 50;
+  const int extent = y_axis ? screen->height() - window.outerHeight()
+                            : screen->width() - window.outerWidth();
+  const int range = extent - margin;
+  if (range <= 0) {
+    return 10;
+  }
+  const uint32_t offset =
+      fingerprint::RandomBelow(y_axis ? "screenY" : "screenX",
+                               static_cast<uint32_t>(range));
+  return margin + static_cast<int>(offset);
 }
 
