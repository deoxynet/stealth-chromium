-  return chrome_client.RootWindowRect(*frame).height();
+  // fp-patches: never report an outer size larger than the spoofed
+  // screen's available area — hides headless "window bigger than screen"
+  // tells and keeps outer* consistent with screen.avail* (spec 31).
+  if (fingerprint::Enabled()) {
+    // The Screen accessor is non-const only because it lazily creates the
+    // window's Screen; reading it from these const getters is safe.
+    const int avail =
+        const_cast<LocalDOMWindow*>(this)->screen()->availHeight();
+    return avail < outer_height ? avail : outer_height;
+  }
+  return outer_height;
 }
 
