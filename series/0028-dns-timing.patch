+
+// fp-patches: DNS/connect timing normalization (spec
+// patches/24-dns-timing.md). Behind a proxy there is no local DNS
+// resolution, so cross-origin Resource Timing would otherwise expose
+// domainLookupStart == domainLookupEnd (== 0 or fetchStart) — a proxy-
+// detection fingerprint. The four accessors below replace the DNS/connect
+// window with deterministic offsets derived from (identity seed, request
+// host), anchored at fetchStart(). Same-host subresources keep stock
+// timings.
+
+// The vendor build reads network_switches::kProxyServer; that header is
+// not reachable from blink renderer deps, so use the literal. Note that
+// the stock renderer command line does not inherit --proxy-server, so the
+// practical trigger is --fingerprint-webrtc-ip (propagated by patch 0003).
+constexpr char kProxyServerSwitch[] = "proxy-server";
+
+bool ShouldNormalizeDnsTiming() {
+  static const bool active = [] {
+    if (!fingerprint::Enabled()) {
+      return false;
+    }
+    const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+    return cmd.HasSwitch(switches::kFingerprintWebrtcIp) ||
+           cmd.HasSwitch(kProxyServerSwitch);
+  }();
+  return active;
+}
+
+uint32_t DnsBaseSeed() {
+  static const uint32_t base_seed = [] {
+    // Low 32 bits of the decimal identity seed (the vendor parsed
+    // --fingerprint with StringToInt and kept the low 32 bits; its
+    // TimeTicks fallback is unreachable because a seed is minted
+    // whenever fingerprinting is enabled).
+    if (auto seed = fingerprint::Seed()) {
+      return static_cast<uint32_t>(*seed);
+    }
+    return static_cast<uint32_t>(fingerprint::HashFor("dns-timing"));
+  }();
+  return base_seed;
+}
+
+// Vendor host hash: Java-style h = 31 * h + c over the host characters
+// (Latin-1 characters are read zero-extended, so both string flavors hash
+// identically).
+uint32_t DnsHostHash(const String& host) {
+  uint32_t hash = 0;
+  const StringView view(host);
+  for (unsigned i = 0; i < view.length(); ++i) {
+    hash = 31 * hash + view[i];
+  }
+  return hash;
+}
+
+String ResourceHost(const String& url) {
+  return KURL(url).Host().ToString();
+}
+
+// Synthetic (DNS start offset, DNS duration) pair in milliseconds over
+// fetchStart(); {0, 0} means "same-host subresource, do not spoof".
+std::pair<double, double> ComputeDnsOffsets(const String& url,
+                                            const AtomicString& initiator,
+                                            DOMWindow* window) {
+  const String host = ResourceHost(url);
+  if (window && initiator != performance_entry_names::kNavigation) {
+    if (auto* local = DynamicTo<LocalDOMWindow>(window)) {
+      if (host == local->document()->Url().Host()) {
+        return {0.0, 0.0};
+      }
+    }
+  }
+  const uint32_t x = DnsHostHash(host) ^ DnsBaseSeed();
+  // Lane 0 in [0.5, ~3.1] ms, lane 1 in [0.5, ~8.0] ms; correction terms
+  // from bits 16-25 and 26-31 of host_hash ^ seed.
+  return {0.5 + (x & 0xff) * 2.5 / 255.0 + ((x >> 16) & 0x3ff) / 10000.0,
+          0.5 + ((x >> 8) & 0xff) * 7.5 / 255.0 + (x >> 26) / 10000.0};
 }
 }  // namespace
 
