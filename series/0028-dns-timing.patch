@@ -342,6 +437,26 @@
 DOMHighResTimeStamp PerformanceResourceTiming::domainLookupEnd() const {
   if (!info_->allow_timing_details) {
     return 0.0;
+  }
+  // fp-patches: synthetic DNS window end; clamped to end 1 ms before the
+  // real connect end and never before the (possibly synthetic) start.
+  if (ShouldNormalizeDnsTiming()) {
+    const std::pair<double, double> offsets =
+        ComputeDnsOffsets(info_->name, initiator_type_, source());
+    if (offsets.second > 0.0) {
+      double end = fetchStart() + offsets.first + offsets.second;
+      if (info_->timing && info_->timing->connect_timing &&
+          !info_->timing->connect_timing->connect_end.is_null()) {
+        end = std::min(
+            end,
+            Performance::MonotonicTimeToDOMHighResTimeStamp(
+                TimeOrigin(), info_->timing->connect_timing->connect_end,
+                info_->allow_negative_values,
+                CrossOriginIsolatedCapability()) -
+                1.0);
+      }
+      return std::max(end, domainLookupStart());
+    }
   }
   if (!info_->timing || !info_->timing->connect_timing ||
       info_->timing->connect_timing->domain_lookup_end.is_null()) {
@@ -370,9 +485,16 @@
     connect_start = info_->timing->connect_timing->domain_lookup_end;
   }
 
-  return Performance::MonotonicTimeToDOMHighResTimeStamp(
-      TimeOrigin(), connect_start, info_->allow_negative_values,
-      CrossOriginIsolatedCapability());
+  const double stock_connect_start =
+      Performance::MonotonicTimeToDOMHighResTimeStamp(
+          TimeOrigin(), connect_start, info_->allow_negative_values,
+          CrossOriginIsolatedCapability());
+  // fp-patches: keep the synthetic window monotonic — never report a
+  // connectStart before the (possibly synthetic) domainLookupEnd.
+  if (ShouldNormalizeDnsTiming()) {
+    return std::max(stock_connect_start, domainLookupEnd());
+  }
+  return stock_connect_start;
 }
 
