From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fp-patches contributors
Date: Thu, 1 Jan 2026 00:00:00 +0000
Subject: [PATCH 30] fingerprint: WebCodecs AAC support persona
X-Spec: patches/26-aac-codec.md
X-Files: third_party/blink/renderer/modules/webcodecs/audio_encoder.cc

---

--- a/third_party/blink/renderer/modules/webcodecs/audio_encoder.cc
+++ b/third_party/blink/renderer/modules/webcodecs/audio_encoder.cc
@@ -20,6 +20,7 @@
 #include "media/base/offloading_audio_encoder.h"
 #include "media/mojo/clients/mojo_audio_encoder.h"
 #include "media/mojo/mojom/interface_factory.mojom.h"
+#include "third_party/blink/public/common/fingerprint/fingerprint.h"
 #include "third_party/blink/public/common/thread_safe_browser_interface_broker_proxy.h"
 #include "third_party/blink/public/mojom/use_counter/metrics/web_feature.mojom-blink.h"
 #include "third_party/blink/public/platform/platform.h"
@@ -325,7 +326,21 @@
       return true;
     }
     case media::AudioCodec::kAAC: {
-      if (media::MojoAudioEncoder::IsSupported(media::AudioCodec::kAAC)) {
+      bool platform_aac_supported =
+          media::MojoAudioEncoder::IsSupported(media::AudioCodec::kAAC);
+      // fp-patches: a windows persona claims platform AAC support even on
+      // hosts without one, keeping AudioEncoder.isConfigSupported() for
+      // 'mp4a.40.2' consistent with the claimed OS (real Windows Chrome
+      // reports supported; the stock gate is disabled by default on
+      // Linux). Spec patches/26-aac-codec.md; the vendor defaulted the
+      // platform to "windows" when the switch was absent, fp-patches
+      // requires an explicit persona and falls back to stock otherwise.
+      // The parameter allow-lists below are stock and unchanged.
+      if (!platform_aac_supported && fingerprint::Enabled() &&
+          fingerprint::SpoofedPlatform() == fingerprint::Platform::kWindows) {
+        platform_aac_supported = true;
+      }
+      if (platform_aac_supported) {
         if (!VerifyParameterValues(config->options.channels,
                                    "Unsupported number of channels.", {1, 2, 6},
                                    js_error_message)) {
