+inline constexpr size_t kNvidiaGpuModelCount =
+    sizeof(kNvidiaGpuModels) / sizeof(kNvidiaGpuModels[0]);
+
+// Lowercased --fingerprint-platform, default "linux" when absent (vendor
+// build resolved the platform locally in the webgpu TU; default pool is
+// NVIDIA).
+inline std::string ResolvePlatform() {
+  const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+  if (cmd.HasSwitch(switches::kFingerprintPlatform)) {
+    const std::string value =
+        cmd.GetSwitchValueASCII(switches::kFingerprintPlatform);
+    if (base::IsStringASCII(value)) {
+      return base::ToLowerASCII(value);
+    }
+  }
+  return "linux";
+}
+
+// Index into kNvidiaGpuModels: an explicit --fingerprint-gpu-renderer whose
+// value contains a model name selects that model (first match wins, same
+// iteration order as the WebGL persona); otherwise the identity seed hashes
+// to a stable index. nullopt = no persona model (custom renderer string).
+inline std::optional<size_t> ResolveNvidiaModelIndex() {
+  const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+  if (cmd.HasSwitch(switches::kFingerprintGpuRenderer)) {
+    const std::string value =
+        cmd.GetSwitchValueASCII(switches::kFingerprintGpuRenderer);
+    if (!base::IsStringASCII(value)) {
+      return std::nullopt;
+    }
+    for (size_t i = 0; i < kNvidiaGpuModelCount; ++i) {
+      if (value.find(kNvidiaGpuModels[i].name) != std::string::npos) {
+        return i;
+      }
+    }
+    return std::nullopt;
+  }
+  const uint32_t hash =
+      static_cast<uint32_t>(fingerprint::HashFor("gpu_renderer"));
+  return hash % kNvidiaGpuModelCount;
+}
+
+// Persona vendor: "" = no spoof (fingerprinting off), else "apple" on the
+// macOS persona and "nvidia" everywhere else.
+inline std::string GetVendor() {
+  if (!fingerprint::Enabled()) {
+    return std::string();
+  }
+  return ResolvePlatform() == "macos" ? "apple" : "nvidia";
+}
+
+// Persona architecture: NVIDIA generation name derived from the PCI device
+// id bucket (16-entry vendor-observed table, verbatim including the
+// 0x21xx/0x23xx/0x2Exx "lovelace" quirks), or the Apple Metal family name.
+inline std::string GetArchitecture() {
+  if (!fingerprint::Enabled()) {
+    return std::string();
+  }
+  if (ResolvePlatform() == "macos") {
+    return "common-3";
+  }
+  const std::optional<size_t> index = ResolveNvidiaModelIndex();
+  if (!index) {
+    return std::string();
+  }
+  // Stealth Chromium: vendor-observed bucket table, indexed by (id - 0x2000) >> 8.
+  static constexpr const char* kArchitectureByBucket[16] = {
+      "ampere",    "lovelace",   // 0x20xx, 0x21xx
+      "ampere",    "lovelace",   // 0x22xx, 0x23xx
+      "ampere",    "ampere",     // 0x24xx, 0x25xx
+      "lovelace",  "lovelace",   // 0x26xx, 0x27xx
+      "lovelace",  "lovelace",   // 0x28xx, 0x29xx
+      "lovelace",  "blackwell",  // 0x2axx, 0x2bxx
+      "blackwell", "blackwell",  // 0x2cxx, 0x2dxx
+      "lovelace",  "blackwell",  // 0x2exx, 0x2fxx
+  };
+  const uint32_t v = kNvidiaGpuModels[*index].device_id - 0x2000;
+  if (v > 0xFFF) {
+    return "lovelace";
+  }
+  return kArchitectureByBucket[v >> 8];
+}
+
+// Persona raw PCI device id (0 = keep the real adapter device string; the
+// macOS persona never spoofs it).
+inline uint32_t GetRawDeviceId() {
+  if (!fingerprint::Enabled()) {
+    return 0;
+  }
+  if (ResolvePlatform() == "macos") {
+    return 0;
+  }
+  const std::optional<size_t> index = ResolveNvidiaModelIndex();
+  if (!index) {
+    return 0;
+  }
+  return kNvidiaGpuModels[*index].device_id;
+}
+
+// Feature plausibility allowlist (vendor-observed bitmask logic, verbatim).
+// Runs UNCONDITIONALLY — it strips implausible/experimental features (e.g.
+// desktop BC compression for the macOS persona, chromium-experimental-*
+// dawn extensions) even when no fingerprint seed is set.
+//
+// Masks over the wgpu::FeatureName numeric values (dawn.json order):
+//   f in 1..15 and bit (f-1) of 0x7B0F: core set every persona may report;
+//   macOS persona additionally allows f in 6..8 (ETC2/ASTC compression);
+//   other personas additionally allow bit f of 0x7F0820 for f <= 0x16
+//   (bc-sliced-3d, shader-f16, clip-distances .. component-swizzle).
+inline bool IsPlausibleFeature(wgpu::FeatureName f) {
+  const uint32_t v = static_cast<uint32_t>(f);
+  if (v >= 1 && v <= 15 && ((0x7B0Fu >> (v - 1)) & 1) != 0) {
+    return true;
+  }
+  if (ResolvePlatform() == "macos") {
+    return v >= 6 && v <= 8;
+  }
+  if (v <= 0x16) {
+    return ((0x7F0820u >> v) & 1) != 0;
+  }
+  return false;
+}
+
+// Stealth Chromium: persona limits (vendor-observed stores/clamps; the exact
+// value table from the disassembly, applied by field name). Overwrites set
+// the persona value; std::min entries clamp the real value down. Only
+// applied while fingerprinting is active, so real limits stay stock.
+inline void ClampLimits(GPUSupportedLimits::ComboLimits& l) {
+  l.maxTextureDimension1D = 0x4000;
+  l.maxTextureDimension2D = 0x4000;
+  l.maxTextureDimension3D = std::min(l.maxTextureDimension3D, 0x800u);
+  l.maxTextureArrayLayers = 0x800;
+  l.maxBindGroups = std::min(l.maxBindGroups, 4u);
+  l.maxBindGroupsPlusVertexBuffers =
+      std::min(l.maxBindGroupsPlusVertexBuffers, 24u);
+  l.maxBindingsPerBindGroup = std::min(l.maxBindingsPerBindGroup, 1000u);
+  l.maxDynamicUniformBuffersPerPipelineLayout = 10;
+  l.maxDynamicStorageBuffersPerPipelineLayout = 8;
+  l.maxSampledTexturesPerShaderStage = 48;
+  l.maxSamplersPerShaderStage = std::min(l.maxSamplersPerShaderStage, 16u);
+  l.maxStorageBuffersPerShaderStage = 16;
+  l.maxStorageTexturesPerShaderStage = 8;
+  l.maxUniformBuffersPerShaderStage =
+      std::min(l.maxUniformBuffersPerShaderStage, 12u);
+  l.maxUniformBufferBindingSize =
+      std::min<uint64_t>(l.maxUniformBufferBindingSize, 0x10000ull);
+  l.maxStorageBufferBindingSize = 0x7FFFFFFC;
+  l.minUniformBufferOffsetAlignment =
+      std::min(l.minUniformBufferOffsetAlignment, 0x100u);
+  l.minStorageBufferOffsetAlignment =
+      std::min(l.minStorageBufferOffsetAlignment, 0x100u);
+  l.maxVertexBuffers = std::min(l.maxVertexBuffers, 8u);
+  l.maxBufferSize = 0x80000000ull;
+  l.maxVertexAttributes = 30;
+  l.maxVertexBufferArrayStride =
+      std::min(l.maxVertexBufferArrayStride, 0x800u);
+  l.maxInterStageShaderVariables = 28;
+  l.maxColorAttachments = std::min(l.maxColorAttachments, 8u);
+  l.maxColorAttachmentBytesPerSample = 0x80;
+  l.maxComputeWorkgroupStorageSize = 0x8000;
+  l.maxComputeInvocationsPerWorkgroup = 0x400;
+  l.maxComputeWorkgroupSizeX = 0x400;
+  l.maxComputeWorkgroupSizeY = 0x400;
+  l.maxComputeWorkgroupSizeZ = std::min(l.maxComputeWorkgroupSizeZ, 0x40u);
+  l.maxComputeWorkgroupsPerDimension =
+      std::min(l.maxComputeWorkgroupsPerDimension, 0xFFFFu);
+  l.maxImmediateSize = 0;
+  l.maxStorageBuffersInVertexStage = 16;
+  l.maxStorageTexturesInVertexStage = 8;
+  l.maxStorageBuffersInFragmentStage = 16;
+  l.maxStorageTexturesInFragmentStage = 8;
+}
