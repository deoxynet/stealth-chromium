+// kNvidiaGpuModels in modules/webgl/gpu_fingerprint.cc (ungoogled-chromium
+// table lineage); the index is shared with the WebGL persona, do not
+// reorder. (name, PCI device id)
+struct NvidiaGpuModel {
+  const char* name;
+  uint32_t device_id;
+};
