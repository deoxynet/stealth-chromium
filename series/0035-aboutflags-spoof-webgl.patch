--- a/third_party/blink/public/common/features.h
+++ b/third_party/blink/public/common/features.h
@@ -1729,6 +1729,16 @@
     kSpeculativeServiceWorkerWarmUpOnPointerover;
 BLINK_COMMON_EXPORT extern const base::FeatureParam<bool>
     kSpeculativeServiceWorkerWarmUpOnPointerdown;
+
+// fp-patches: about:flags "Spoof WebGL Info" entry (ungoogled-chromium
+// lineage). When enabled, WEBGL_debug_renderer_info queries report the
+// feature-param vendor/renderer strings instead of the real GPU strings.
+// Lower priority than the identity-seed GPU persona (gpu_fingerprint.h).
+BLINK_COMMON_EXPORT BASE_DECLARE_FEATURE(kSpoofWebGLInfo);
+BLINK_COMMON_EXPORT BASE_DECLARE_FEATURE_PARAM(std::string,
+                                               kSpoofWebGLVendorParam);
+BLINK_COMMON_EXPORT BASE_DECLARE_FEATURE_PARAM(std::string,
+                                               kSpoofWebGLRendererParam);
 
 BLINK_COMMON_EXPORT BASE_DECLARE_FEATURE(kServiceWorkerSyntheticResponse);
 
--- a/third_party/blink/common/features.cc
+++ b/third_party/blink/common/features.cc
@@ -2230,6 +2230,25 @@
 const base::FeatureParam<bool> kSpeculativeServiceWorkerWarmUpOnPointerdown{
     &kSpeculativeServiceWorkerWarmUp, "sw_warm_up_on_pointerdown", true};
 
+// fp-patches: about:flags "Spoof WebGL Info" entry (ungoogled-chromium
+// lineage). The default " " (single space) keeps the ungoogled behavior: a
+// non-empty placeholder is reported when the feature is enabled without
+// selecting one of the presets, avoiding obvious site breakage.
+BASE_FEATURE(kSpoofWebGLInfo, "SpoofWebGLInfo",
+             base::FEATURE_DISABLED_BY_DEFAULT);
+
+BASE_FEATURE_PARAM(std::string,
+                   kSpoofWebGLVendorParam,
+                   &kSpoofWebGLInfo,
+                   "vendor",
+                   " ");
+
+BASE_FEATURE_PARAM(std::string,
+                   kSpoofWebGLRendererParam,
+                   &kSpoofWebGLInfo,
+                   "renderer",
+                   " ");
+
 // (crbug.com/352578800): Enables building a sysnthetic response by
 // ServiceWorker. For navigation requests, the pre-learned static response
 // header is returned in parallel with dispatching the network request.
--- a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
+++ b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
@@ -4051,6 +4051,16 @@
         // fp-patches: persona renderer string when GPU spoofing is active.
         if (IsFingerprintGpuActive()) {
           const std::string renderer = GetGLRendererStringForFingerprint();
+          if (!renderer.empty()) {
+            return WebGLAny(script_state, String::FromUTF8(renderer));
+          }
+        }
+        // fp-patches: about:flags "Spoof WebGL Info" fallback (ungoogled
+        // lineage). Only reached when no persona renderer was served, so
+        // the feature is inert for fingerprinted profiles.
+        if (base::FeatureList::IsEnabled(blink::features::kSpoofWebGLInfo)) {
+          const std::string renderer =
+              blink::features::kSpoofWebGLRendererParam.Get();
           if (!renderer.empty()) {
             return WebGLAny(script_state, String::FromUTF8(renderer));
           }
@@ -4067,6 +4077,16 @@
         // fp-patches: persona vendor string when GPU spoofing is active.
         if (IsFingerprintGpuActive()) {
           const std::string vendor = GetGLVendorStringForFingerprint();
+          if (!vendor.empty()) {
+            return WebGLAny(script_state, String::FromUTF8(vendor));
+          }
+        }
+        // fp-patches: about:flags "Spoof WebGL Info" fallback (ungoogled
+        // lineage). Only reached when no persona vendor was served, so the
+        // feature is inert for fingerprinted profiles.
+        if (base::FeatureList::IsEnabled(blink::features::kSpoofWebGLInfo)) {
+          const std::string vendor =
+              blink::features::kSpoofWebGLVendorParam.Get();
           if (!vendor.empty()) {
             return WebGLAny(script_state, String::FromUTF8(vendor));
           }
