+
+// Stealth Chromium (spec: patches/38-socks5-udp-associate-warm-pool.md):
+// SOCKS5 warm connection pool. Keeps a small set of TCP sockets to the
+// SOCKS5 proxy that have already completed the RFC 1928 method
+// negotiation (and RFC 1929 username/password auth when the proxy is
+// credentialed) so consumers — the QUIC UDP-ASSOCIATE datagram socket and
+// the TCP tunnel path in SOCKSConnectJob — can skip per-request proxy
+// authentication. Class/method names follow the vendor binary's symbol
+// table (Socks5WarmPool::{Initialize, StartOneConnect, TakeWarmSocket,
+// PurgeStale, PromoteToWarm, OnTcpConnectComplete, OnGreet*Complete,
+// OnAuth*Complete}).
+
+#ifndef NET_SOCKET_SOCKS5_WARM_POOL_H_
+#define NET_SOCKET_SOCKS5_WARM_POOL_H_
+
+#include <stdint.h>
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/no_destructor.h"
+#include "base/time/time.h"
+#include "net/base/address_list.h"
+#include "net/base/auth.h"
+#include "net/base/host_port_pair.h"
+#include "net/base/net_export.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+
+namespace net {
+
+class ClientSocketFactory;
+class DrainableIOBuffer;
+class GrowableIOBuffer;
+class NetLog;
+class StreamSocket;
+
+// Pool of pre-connected (and pre-authenticated) SOCKS5 TCP sockets.
+//
+// The pool is keyed by the proxy configuration passed to Initialize();
+// re-initializing with a different address list drops all state. Entries
+// older than the warm TTL are dropped by PurgeStale().
+class NET_EXPORT_PRIVATE Socks5WarmPool {
+ public:
+  Socks5WarmPool(const Socks5WarmPool&) = delete;
+  Socks5WarmPool& operator=(const Socks5WarmPool&) = delete;
+
+  // Process-wide pool (one SOCKS5 proxy configuration per browser
+  // profile at a time; the vendor build also carries no per-context
+  // pool symbol).
+  static Socks5WarmPool* GetInstance();
+
+  // Configures the pool for |proxy_addresses| and starts background
+  // warm connects. Idempotent while the configuration is unchanged.
+  // Signature as recovered from the vendor symbol table.
+  void Initialize(const AddressList& proxy_addresses,
+                  std::optional<AuthCredentials> credentials,
+                  ClientSocketFactory* client_socket_factory,
+                  NetLog* net_log,
+                  const NetworkTrafficAnnotationTag& traffic_annotation);
+
+  // Removes warm entries that have been idle longer than the TTL.
+  void PurgeStale();
+
+  // Starts one background TCP connect + greeting + auth handshake, if
+  // the pool is below its target size.
+  void StartOneConnect();
+
+  // Returns a socket to the proxy whose SOCKS5 method negotiation (and
+  // username/password auth, if configured) has completed, or nullptr if
+  // none is available. Refills the pool in the background.
+  std::unique_ptr<StreamSocket> TakeWarmSocket();
+
+  // Stock Chromium has no credential source for SOCKS proxies (it does
+  // not implement RFC 1929 at all), so credentials are registered here
+  // by the embedder; every SOCKS5 consumer in this patch reads them
+  // from this single registration point.
+  static void SetProxyCredentials(std::optional<AuthCredentials> credentials);
+  static const std::optional<AuthCredentials>& GetProxyCredentials();
+
+  // Moves a socket whose greeting/auth completed from the pending map
+  // to the warm vector.
+  void PromoteToWarm(StreamSocket* socket);
+
+  // Number of sockets stored (pending + warm); for tests and netlog.
+  size_t GetSizeForTesting() const;
+
+ private:
+  friend class base::NoDestructor<Socks5WarmPool>;
+
+  struct PendingEntry {
+    PendingEntry();
+    PendingEntry(PendingEntry&&);
+    PendingEntry& operator=(PendingEntry&&);
+    ~PendingEntry();
+
+    // Owns the socket between TCP connect and warm promotion.
+    std::unique_ptr<StreamSocket> socket;
+    scoped_refptr<DrainableIOBuffer> write_buf;
+    scoped_refptr<GrowableIOBuffer> read_buf;
+    // Method the proxy selected in its greeting reply (0x00 none,
+    // 0x02 username/password).
+    uint8_t selected_method = 0x00;
+    // Index of the address in |proxy_addresses| being attempted.
+    size_t address_index = 0;
+  };
+
+  struct WarmEntry {
+    WarmEntry(std::unique_ptr<StreamSocket> socket, base::TimeTicks created);
+    WarmEntry(WarmEntry&&);
+    WarmEntry& operator=(WarmEntry&&);
+    ~WarmEntry();
+
+    std::unique_ptr<StreamSocket> socket;
+    base::TimeTicks created;
+  };
+
+  Socks5WarmPool();
+  ~Socks5WarmPool();
+
+  PendingEntry* FindPending(StreamSocket* socket);
+
+  // Handshake continuation callbacks; all take the socket the event
+  // belongs to (symbol-observed signatures).
+  void OnTcpConnectComplete(StreamSocket* socket, int result);
+  void OnGreetWriteComplete(StreamSocket* socket, int result);
+  void OnGreetReadComplete(StreamSocket* socket, int result);
+  void OnAuthWriteComplete(StreamSocket* socket, int result);
+  void OnAuthReadComplete(StreamSocket* socket, int result);
+
+  void DestroyPending(StreamSocket* socket);
+
+  AddressList proxy_addresses_;
+  std::optional<AuthCredentials> credentials_;
+  raw_ptr<ClientSocketFactory> client_socket_factory_ = nullptr;
+  raw_ptr<NetLog> net_log_ = nullptr;
+  // Overwritten by Initialize() before any socket is created.
+  NetworkTrafficAnnotationTag traffic_annotation_ = MISSING_TRAFFIC_ANNOTATION;
+
+  // Symbol-observed container shapes.
+  std::map<StreamSocket*, PendingEntry> pending_;
+  std::vector<WarmEntry> warm_;
+};
+
+// Returns a StreamSocket that finishes the SOCKS5 CONNECT handshake
+// (request/reply only — the method negotiation and, when configured,
+// RFC 1929 auth have already run) over |warm_socket|, tunneling to
+// |destination|. Used by SOCKSConnectJob for sockets taken from
+// Socks5WarmPool; the vendor's exact consumption path is not
+// recoverable from the binary, so it lives here rather than in a
+// modified SOCKS5ClientSocket.
+std::unique_ptr<StreamSocket> CreateSocks5WarmTunnelSocket(
+    std::unique_ptr<StreamSocket> warm_socket,
+    const HostPortPair& destination,
+    const NetworkTrafficAnnotationTag& traffic_annotation);
+
+}  // namespace net
