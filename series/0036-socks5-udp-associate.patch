+}
+
+// Returns the number of bytes the SOCKS5 UDP header occupies for
+// |target| (RSV/FRAG/ATYP/addr/port).
+// static
+size_t SOCKS5DatagramClientSocket::BuildUdpHeader(const IPEndPoint& target,
+                                                  uint8_t* header) {
+  size_t offset = 0;
+  header[offset++] = 0x00;  // RSV high.
+  header[offset++] = 0x00;  // RSV low.
+  header[offset++] = 0x00;  // Fragment number; fragmentation unused.
+  const IPAddress& address = target.address();
+  if (address.IsIPv4()) {
+    header[offset++] = kAtypIpv4;
+    std::memcpy(header + offset, address.bytes().data(), 4);
+    offset += 4;
+  } else {
+    header[offset++] = kAtypIpv6;
+    std::memcpy(header + offset, address.bytes().data(), 16);
+    offset += 16;
+  }
+  auto port = base::U16ToBigEndian(target.port());
+  std::memcpy(header + offset, port.data(), port.size());
+  offset += port.size();
+  return offset;
+}
+
+int SOCKS5DatagramClientSocket::ProcessIncomingDatagram(const uint8_t* data,
+                                                        int len,
+                                                        IOBuffer* user_buf,
+                                                        int user_buf_len) {
+  // Strip the SOCKS5 UDP header: RSV(2) FRAG(1) ATYP(1) addr port.
+  if (len < 4) {
+    return ERR_INVALID_RESPONSE;
+  }
+  if (data[2] != 0x00) {
+    // Fragmented datagrams are not supported.
+    return ERR_INVALID_RESPONSE;
+  }
+  const size_t length = static_cast<size_t>(len);
+  size_t offset = 3;
+  const uint8_t address_type = data[offset++];
+  switch (address_type) {
+    case kAtypIpv4:
+      offset += 4;
+      break;
+    case kAtypDomain:
+      if (length < offset + 1) {
+        return ERR_INVALID_RESPONSE;
+      }
+      offset += 1 + data[offset];
+      break;
+    case kAtypIpv6:
+      offset += 16;
+      break;
+    default:
+      return ERR_INVALID_RESPONSE;
+  }
+  offset += 2;  // Source port.
+  if (offset > length) {
+    return ERR_INVALID_RESPONSE;
+  }
+  const size_t payload_len = length - offset;
+  if (static_cast<int>(payload_len) > user_buf_len) {
+    return ERR_MSG_TOO_BIG;
+  }
+  std::memcpy(user_buf->data(), data + offset, payload_len);
+  return static_cast<int>(payload_len);
+}
+
+int SOCKS5DatagramClientSocket::Read(IOBuffer* buf,
+                                     int buf_len,
+                                     CompletionOnceCallback callback) {
+  DCHECK(connected_);
+  DCHECK(!callback.is_null());
+  DCHECK(!incoming_read_buf_);
+
+  incoming_read_buf_ = base::MakeRefCounted<IOBufferWithSize>(
+      kMaxUdpPayloadSize + static_cast<int>(kMaxUdpHeaderSize));
+  int rv = udp_socket_->Read(
+      incoming_read_buf_.get(), incoming_read_buf_->size(),
+      base::BindOnce(&SOCKS5DatagramClientSocket::OnUdpReadComplete,
+                     base::Unretained(this), buf, buf_len,
+                     std::move(callback)));
+  if (rv == ERR_IO_PENDING) {
+    return rv;
+  }
+  // Synchronous completion: strip the header and return the payload
+  // directly (the callback will not run).
+  if (rv > 0) {
+    rv = ProcessIncomingDatagram(
+        reinterpret_cast<const uint8_t*>(incoming_read_buf_->data()), rv, buf,
+        buf_len);
+  }
+  incoming_read_buf_.reset();
+  return rv;
+}
+
+void SOCKS5DatagramClientSocket::OnUdpReadComplete(
+    raw_ptr<IOBuffer> user_buf,
+    int user_buf_len,
+    CompletionOnceCallback callback,
+    int result) {
+  DCHECK_NE(ERR_IO_PENDING, result);
+  scoped_refptr<IOBufferWithSize> incoming = std::move(incoming_read_buf_);
+  if (result <= 0) {
+    std::move(callback).Run(result);
+    return;
+  }
+  std::move(callback).Run(ProcessIncomingDatagram(
+      reinterpret_cast<const uint8_t*>(incoming->data()), result, user_buf,
+      user_buf_len));
+}
+
+int SOCKS5DatagramClientSocket::Write(
+    IOBuffer* buf,
+    int buf_len,
+    CompletionOnceCallback callback,
+    const NetworkTrafficAnnotationTag& traffic_annotation) {
+  DCHECK(connected_);
+  DCHECK(!callback.is_null());
+  DCHECK(!outgoing_write_buf_);
+  if (buf_len > kMaxUdpPayloadSize) {
+    return ERR_MSG_TOO_BIG;
+  }
+
+  // Stealth Chromium: frame the datagram for the associate target and relay
+  // it (netlog type SOCKS5_UDP_SEND_TO_TARGET).
+  outgoing_write_buf_ =
+      base::MakeRefCounted<IOBufferWithSize>(buf_len + kMaxUdpHeaderSize);
+  const size_t header_len =
+      BuildUdpHeader(target_address_,
+                     reinterpret_cast<uint8_t*>(outgoing_write_buf_->data()));
+  std::memcpy(outgoing_write_buf_->data() + header_len, buf->data(), buf_len);
+  net_log_.AddEvent(NetLogEventType::SOCKS5_UDP_SEND_TO_TARGET, [&] {
+    base::DictValue dict;
+    dict.Set("bytes", buf_len);
+    return dict;
+  });
+  int rv = udp_socket_->Write(
+      outgoing_write_buf_.get(), static_cast<int>(header_len + buf_len),
+      base::BindOnce(&SOCKS5DatagramClientSocket::OnUdpWriteComplete,
+                     base::Unretained(this), std::move(callback),
+                     static_cast<int>(header_len)),
+      kSocks5UdpTrafficAnnotation);
+  if (rv == ERR_IO_PENDING) {
+    return rv;
+  }
+  // Synchronous completion: report the user payload size, not the
+  // framed size.
+  outgoing_write_buf_.reset();
+  if (rv > 0) {
+    rv -= static_cast<int>(header_len);
+  }
+  return rv;
+}
+
+void SOCKS5DatagramClientSocket::OnUdpWriteComplete(
+    CompletionOnceCallback callback,
+    int header_len,
+    int result) {
+  DCHECK_NE(ERR_IO_PENDING, result);
+  outgoing_write_buf_.reset();
+  if (result > 0) {
+    result -= header_len;
+  }
+  std::move(callback).Run(result);
+}
+
+int SOCKS5DatagramClientSocket::ConnectInternal(
+    DatagramSocket::BindType bind_type,
+    handles::NetworkHandle network,
+    const IPEndPoint& address,
+    CompletionOnceCallback callback) {
+  DCHECK_EQ(STATE_NONE, next_state_);
+  DCHECK(connect_callback_.is_null());
+
+  target_address_ = address;
+  network_ = network;
+
+  net_log_.BeginEvent(NetLogEventType::SOCKS5_UDP_ASSOCIATE_TARGET);
+  next_state_ = STATE_RESOLVE_PROXY;
+  int rv = DoLoop(OK);
+  if (rv == ERR_IO_PENDING) {
+    connect_callback_ = std::move(callback);
+  } else {
+    // Complete synchronously, mirroring UDPClientSocket: the callback
+    // (if any) is dropped and the result returned to the caller, which
+    // is responsible for running its own completion path. Running the
+    // callback here as well would double-fire the QUIC pool's split
+    // callback.
+    net_log_.EndEvent(NetLogEventType::SOCKS5_UDP_ASSOCIATE_TARGET, [&] {
+      return UdpTargetNetLogParams(rv);
+    });
+  }
+  return rv;
+}
+
+void SOCKS5DatagramClientSocket::OnIOComplete(int result) {
+  int rv = DoLoop(result);
+  if (rv != ERR_IO_PENDING) {
+    net_log_.EndEvent(NetLogEventType::SOCKS5_UDP_ASSOCIATE_TARGET, [&] {
+      return UdpTargetNetLogParams(rv);
+    });
+    if (!connect_callback_.is_null()) {
+      std::move(connect_callback_).Run(rv);
+    }
+  }
+}
+
+int SOCKS5DatagramClientSocket::DoLoop(int last_io_result) {
+  DCHECK_NE(STATE_NONE, next_state_);
+  int rv = last_io_result;
+  do {
+    State state = next_state_;
+    next_state_ = STATE_NONE;
+    switch (state) {
+      case STATE_RESOLVE_PROXY:
+        DCHECK_EQ(OK, rv);
+        rv = DoResolveProxy();
+        break;
+      case STATE_RESOLVE_PROXY_COMPLETE:
+        rv = DoResolveProxyComplete(rv);
+        break;
+      case STATE_TCP_CONNECT:
+        DCHECK_EQ(OK, rv);
+        rv = DoTcpConnect();
+        break;
+      case STATE_TCP_CONNECT_COMPLETE:
+        rv = DoTcpConnectComplete(rv);
+        break;
+      case STATE_GREET_WRITE:
+        DCHECK_EQ(OK, rv);
+        rv = DoGreetWrite();
+        break;
+      case STATE_GREET_WRITE_COMPLETE:
+        rv = DoGreetWriteComplete(rv);
+        break;
+      case STATE_GREET_READ:
+        DCHECK_EQ(OK, rv);
+        rv = DoGreetRead();
+        break;
+      case STATE_GREET_READ_COMPLETE:
+        rv = DoGreetReadComplete(rv);
+        break;
+      case STATE_AUTH_WRITE:
+        DCHECK_EQ(OK, rv);
+        rv = DoAuthWrite();
+        break;
+      case STATE_AUTH_WRITE_COMPLETE:
+        rv = DoAuthWriteComplete(rv);
+        break;
+      case STATE_AUTH_READ:
+        DCHECK_EQ(OK, rv);
+        rv = DoAuthRead();
+        break;
+      case STATE_AUTH_READ_COMPLETE:
+        rv = DoAuthReadComplete(rv);
+        break;
+      case STATE_ASSOCIATE_WRITE:
+        DCHECK_EQ(OK, rv);
+        rv = DoAssociateWrite();
+        break;
+      case STATE_ASSOCIATE_WRITE_COMPLETE:
+        rv = DoAssociateWriteComplete(rv);
+        break;
+      case STATE_ASSOCIATE_READ:
+        DCHECK_EQ(OK, rv);
+        rv = DoAssociateRead();
+        break;
+      case STATE_ASSOCIATE_READ_COMPLETE:
+        rv = DoAssociateReadComplete(rv);
+        break;
+      case STATE_UDP_CONNECT:
+        DCHECK_EQ(OK, rv);
+        rv = DoUdpConnect();
+        break;
+      case STATE_UDP_CONNECT_COMPLETE:
+        rv = DoUdpConnectComplete(rv);
+        break;
+      default:
+        NOTREACHED() << "bad state";
+    }
+  } while (rv != ERR_IO_PENDING && next_state_ != STATE_NONE);
+  return rv;
+}
+
+int SOCKS5DatagramClientSocket::DoResolveProxy() {
+  next_state_ = STATE_RESOLVE_PROXY_COMPLETE;
+  resolve_request_ = host_resolver_->CreateRequest(
+      proxy_server_.host_port_pair(), NetworkAnonymizationKey(), net_log_,
+      std::nullopt);
+  return resolve_request_->Start(base::BindOnce(
+      &SOCKS5DatagramClientSocket::OnIOComplete, base::Unretained(this)));
+}
+
+int SOCKS5DatagramClientSocket::DoResolveProxyComplete(int result) {
+  if (result != OK) {
+    return result;
+  }
+  proxy_addresses_ = resolve_request_->GetAddressResults();
+  resolve_request_.reset();
+  if (proxy_addresses_.empty()) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  next_state_ = STATE_TCP_CONNECT;
+  return OK;
+}
+
+int SOCKS5DatagramClientSocket::DoTcpConnect() {
+  next_state_ = STATE_TCP_CONNECT_COMPLETE;
+
+  // Stealth Chromium: prefer a warm socket from Socks5WarmPool — its
+  // greeting/auth have already completed, so jump straight to the
+  // associate request.
+  transport_socket_ = Socks5WarmPool::GetInstance()->TakeWarmSocket();
+  if (transport_socket_) {
+    transport_is_warm_ = true;
+    next_state_ = STATE_ASSOCIATE_WRITE;
+    return OK;
+  }
+
+  transport_socket_ = client_socket_factory_->CreateTransportClientSocket(
+      proxy_addresses_, /*socket_performance_watcher=*/nullptr,
+      /*network_quality_estimator=*/nullptr, net_log_.net_log(),
+      net_log_.source());
+  return transport_socket_->Connect(base::BindOnce(
+      &SOCKS5DatagramClientSocket::OnIOComplete, base::Unretained(this)));
+}
+
+int SOCKS5DatagramClientSocket::DoTcpConnectComplete(int result) {
+  if (result != OK) {
+    return result;
+  }
+  next_state_ = STATE_GREET_WRITE;
+  return OK;
+}
+
+int SOCKS5DatagramClientSocket::DoGreetWrite() {
+  next_state_ = STATE_GREET_WRITE_COMPLETE;
+  if (!write_buf_) {
+    std::vector<uint8_t> greet{kSOCKS5Version, 0x01, kNoAuthMethod};
+    if (Socks5WarmPool::GetProxyCredentials()) {
+      greet[1] = 0x02;
+      greet.push_back(kUsernamePasswordMethod);
+    }
+    auto base_buffer = base::MakeRefCounted<VectorIOBuffer>(std::move(greet));
+    write_buf_ = base::MakeRefCounted<DrainableIOBuffer>(std::move(base_buffer),
+                                                         base_buffer->size());
+  }
+  return transport_socket_->Write(
+      write_buf_.get(), write_buf_->BytesRemaining(),
+      base::BindOnce(&SOCKS5DatagramClientSocket::OnIOComplete,
+                     base::Unretained(this)),
+      kSocks5UdpTrafficAnnotation);
+}
+
+int SOCKS5DatagramClientSocket::DoGreetWriteComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  write_buf_->DidConsume(result);
+  if (write_buf_->BytesRemaining() == 0) {
+    write_buf_.reset();
+    next_state_ = STATE_GREET_READ;
+  } else {
+    next_state_ = STATE_GREET_WRITE;
+  }
+  return OK;
+}
+
+int SOCKS5DatagramClientSocket::DoGreetRead() {
+  next_state_ = STATE_GREET_READ_COMPLETE;
+  if (!read_buf_) {
+    read_buf_ = base::MakeRefCounted<GrowableIOBuffer>();
+    read_buf_->SetCapacity(kGreetReplySize);
+  }
+  return transport_socket_->Read(
+      read_buf_.get(), read_buf_->RemainingCapacity(),
+      base::BindOnce(&SOCKS5DatagramClientSocket::OnIOComplete,
+                     base::Unretained(this)));
+}
+
+int SOCKS5DatagramClientSocket::DoGreetReadComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  if (result == 0) {
+    net_log_.AddEvent(NetLogEventType::SOCKS_UNEXPECTEDLY_CLOSED_DURING_GREETING);
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  read_buf_->set_offset(read_buf_->offset() + result);
+  if (read_buf_->RemainingCapacity() > 0) {
+    next_state_ = STATE_GREET_READ;
+    return OK;
+  }
+
+  base::span<uint8_t> data = read_buf_->span_before_offset();
+  if (data[0] != kSOCKS5Version) {
+    net_log_.AddEventWithIntParams(NetLogEventType::SOCKS_UNEXPECTED_VERSION,
+                                   "version", data[0]);
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  const uint8_t method = data[1];
+  read_buf_.reset();
+  if (method == kNoAuthMethod) {
+    next_state_ = STATE_ASSOCIATE_WRITE;
+    return OK;
+  }
+  if (method == kUsernamePasswordMethod &&
+      Socks5WarmPool::GetProxyCredentials()) {
+    need_auth_ = true;
+    next_state_ = STATE_AUTH_WRITE;
+    return OK;
+  }
+  net_log_.AddEventWithIntParams(NetLogEventType::SOCKS_UNEXPECTED_AUTH,
+                                 "method", method);
+  return ERR_SOCKS_CONNECTION_FAILED;
+}
+
+int SOCKS5DatagramClientSocket::DoAuthWrite() {
+  next_state_ = STATE_AUTH_WRITE_COMPLETE;
+  if (!write_buf_) {
+    const auto& credentials = Socks5WarmPool::GetProxyCredentials();
+    const std::string username = base::UTF16ToUTF8(credentials->username());
+    const std::string password = base::UTF16ToUTF8(credentials->password());
+    if (username.size() > 0xFF || password.size() > 0xFF) {
+      return ERR_SOCKS_CONNECTION_FAILED;
+    }
+    std::vector<uint8_t> auth;
+    auth.reserve(3 + username.size() + password.size());
+    auth.push_back(kUsernamePasswordVersion);
+    auth.push_back(static_cast<uint8_t>(username.size()));
+    auth.insert(auth.end(), username.begin(), username.end());
+    auth.push_back(static_cast<uint8_t>(password.size()));
+    auth.insert(auth.end(), password.begin(), password.end());
+    auto base_buffer = base::MakeRefCounted<VectorIOBuffer>(std::move(auth));
+    write_buf_ = base::MakeRefCounted<DrainableIOBuffer>(std::move(base_buffer),
+                                                         base_buffer->size());
+  }
+  return transport_socket_->Write(
+      write_buf_.get(), write_buf_->BytesRemaining(),
+      base::BindOnce(&SOCKS5DatagramClientSocket::OnIOComplete,
+                     base::Unretained(this)),
+      kSocks5UdpTrafficAnnotation);
+}
+
+int SOCKS5DatagramClientSocket::DoAuthWriteComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  write_buf_->DidConsume(result);
+  if (write_buf_->BytesRemaining() == 0) {
+    write_buf_.reset();
+    next_state_ = STATE_AUTH_READ;
+  } else {
+    next_state_ = STATE_AUTH_WRITE;
+  }
+  return OK;
+}
+
+int SOCKS5DatagramClientSocket::DoAuthRead() {
+  next_state_ = STATE_AUTH_READ_COMPLETE;
+  if (!read_buf_) {
+    read_buf_ = base::MakeRefCounted<GrowableIOBuffer>();
+    read_buf_->SetCapacity(kAuthReplySize);
+  }
+  return transport_socket_->Read(
+      read_buf_.get(), read_buf_->RemainingCapacity(),
+      base::BindOnce(&SOCKS5DatagramClientSocket::OnIOComplete,
+                     base::Unretained(this)));
+}
+
+int SOCKS5DatagramClientSocket::DoAuthReadComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  if (result == 0) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  read_buf_->set_offset(read_buf_->offset() + result);
+  if (read_buf_->RemainingCapacity() > 0) {
+    next_state_ = STATE_AUTH_READ;
+    return OK;
+  }
+
+  base::span<uint8_t> data = read_buf_->span_before_offset();
+  if (data[0] != kUsernamePasswordVersion || data[1] != 0x00) {
+    net_log_.AddEventWithIntParams(NetLogEventType::SOCKS_UNEXPECTED_AUTH,
+                                   "status", data[1]);
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  read_buf_.reset();
+  next_state_ = STATE_ASSOCIATE_WRITE;
+  return OK;
+}
+
+int SOCKS5DatagramClientSocket::DoAssociateWrite() {
+  next_state_ = STATE_ASSOCIATE_WRITE_COMPLETE;
+  if (!write_buf_) {
+    // CMD 3 (UDP ASSOCIATE) with DST.ADDR/PORT 0.0.0.0:0 — the client
+    // expects the proxy to relay datagrams from the TCP control
+    // connection's source address.
+    const std::vector<uint8_t> request{
+        kSOCKS5Version, kUdpAssociateCommand, kNullByte,
+        kAtypIpv4,      0x00,                 0x00,
+        0x00,           0x00,                 0x00,
+        0x00};
+    auto base_buffer = base::MakeRefCounted<VectorIOBuffer>(request);
+    write_buf_ = base::MakeRefCounted<DrainableIOBuffer>(std::move(base_buffer),
+                                                         base_buffer->size());
+  }
+  return transport_socket_->Write(
+      write_buf_.get(), write_buf_->BytesRemaining(),
+      base::BindOnce(&SOCKS5DatagramClientSocket::OnIOComplete,
+                     base::Unretained(this)),
+      kSocks5UdpTrafficAnnotation);
+}
+
+int SOCKS5DatagramClientSocket::DoAssociateWriteComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  write_buf_->DidConsume(result);
+  if (write_buf_->BytesRemaining() == 0) {
+    write_buf_.reset();
+    next_state_ = STATE_ASSOCIATE_READ;
+  } else {
+    next_state_ = STATE_ASSOCIATE_WRITE;
+  }
+  return OK;
+}
+
+int SOCKS5DatagramClientSocket::DoAssociateRead() {
+  next_state_ = STATE_ASSOCIATE_READ_COMPLETE;
+  if (!read_buf_) {
+    read_buf_ = base::MakeRefCounted<GrowableIOBuffer>();
+    read_buf_->SetCapacity(kAssociateReplyHeaderSize);
+  }
+  return transport_socket_->Read(
+      read_buf_.get(), read_buf_->RemainingCapacity(),
+      base::BindOnce(&SOCKS5DatagramClientSocket::OnIOComplete,
+                     base::Unretained(this)));
+}
+
+int SOCKS5DatagramClientSocket::DoAssociateReadComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  if (result == 0) {
+    net_log_.AddEvent(
+        NetLogEventType::SOCKS_UNEXPECTEDLY_CLOSED_DURING_HANDSHAKE);
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+  read_buf_->set_offset(read_buf_->offset() + result);
+
+  if (read_buf_->offset() == kAssociateReplyHeaderSize) {
+    base::span<uint8_t> data = read_buf_->span_before_offset();
+    if (data[0] != kSOCKS5Version || data[2] != kNullByte) {
+      net_log_.AddEventWithIntParams(NetLogEventType::SOCKS_UNEXPECTED_VERSION,
+                                     "version", data[0]);
+      return ERR_SOCKS_CONNECTION_FAILED;
+    }
+    if (data[1] != 0x00) {
+      net_log_.AddEventWithIntParams(NetLogEventType::SOCKS_SERVER_ERROR,
+                                     "error_code", data[1]);
+      return ERR_SOCKS_CONNECTION_FAILED;
+    }
+    const uint8_t address_type = data[3];
+    int additional_bytes_expected;
+    if (address_type == kAtypDomain) {
+      additional_bytes_expected = data[4];
+    } else if (address_type == kAtypIpv4) {
+      additional_bytes_expected = sizeof(struct in_addr) - 1;
+    } else if (address_type == kAtypIpv6) {
+      additional_bytes_expected = sizeof(struct in6_addr) - 1;
+    } else {
+      net_log_.AddEventWithIntParams(
+          NetLogEventType::SOCKS_UNKNOWN_ADDRESS_TYPE, "address_type",
+          data[3]);
+      return ERR_SOCKS_CONNECTION_FAILED;
+    }
+    additional_bytes_expected += 2;  // Port.
+    read_buf_->SetCapacity(kAssociateReplyHeaderSize +
+                           additional_bytes_expected);
+    next_state_ = STATE_ASSOCIATE_READ;
+    return OK;
+  }
+
+  if (read_buf_->RemainingCapacity() == 0) {
+    // Parse BND.ADDR/BND.PORT — the UDP relay endpoint.
+    base::span<uint8_t> data = read_buf_->span_before_offset();
+    const uint8_t address_type = data[3];
+    const uint8_t* addr = &data[4];
+    size_t addr_len;
+    if (address_type == kAtypIpv4) {
+      addr_len = sizeof(struct in_addr);
+    } else if (address_type == kAtypIpv6) {
+      addr_len = sizeof(struct in6_addr);
+    } else {
+      addr_len = addr[0];
+      addr += 1;
+    }
+    const uint8_t* port_bytes = addr + addr_len;
+    associate_target_ = IPEndPoint(
+        IPAddress(base::span<const uint8_t>(addr, addr_len)),
+        base::U16FromBigEndian(
+            base::span<const uint8_t, 2>(port_bytes, 2)));
+    read_buf_.reset();
+
+    // A reply of 0.0.0.0 means "relay from the same host as the TCP
+    // control connection" (RFC 1928 section 4 practice).
+    if (associate_target_.address().IsIPv4() &&
+        associate_target_.address() == IPAddress(0u, 0u, 0u, 0u)) {
+      IPEndPoint tcp_peer;
+      if (transport_socket_->GetPeerAddress(&tcp_peer) == OK) {
+        associate_target_ =
+            IPEndPoint(tcp_peer.address(), associate_target_.port());
+      }
+    }
+
+    next_state_ = STATE_UDP_CONNECT;
+    return OK;
+  }
+
+  next_state_ = STATE_ASSOCIATE_READ;
+  return OK;
+}
+
+int SOCKS5DatagramClientSocket::DoUdpConnect() {
+  next_state_ = STATE_UDP_CONNECT_COMPLETE;
+  udp_socket_ = client_socket_factory_->CreateDatagramClientSocket(
+      bind_type_, net_log_.net_log(), net_log_.source());
+  if (use_non_blocking_io_) {
+    udp_socket_->UseNonBlockingIO();
+  }
+  if (enable_recv_optimization_) {
+    udp_socket_->EnableRecvOptimization();
+  }
+  if (network_ == handles::kInvalidNetworkHandle) {
+    return udp_socket_->Connect(associate_target_);
+  }
+  return udp_socket_->ConnectUsingNetwork(network_, associate_target_);
+}
+
+int SOCKS5DatagramClientSocket::DoUdpConnectComplete(int result) {
+  if (result != OK) {
+    return result;
+  }
+  connected_ = true;
+  next_state_ = STATE_NONE;
+  return OK;
+}
