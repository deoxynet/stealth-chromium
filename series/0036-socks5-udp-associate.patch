+
+// Stealth Chromium (spec: patches/38-socks5-udp-associate-warm-pool.md):
+// SOCKS5 UDP ASSOCIATE implementation. The TCP control-channel state
+// machine (greet / RFC 1929 auth / associate) mirrors the stock
+// SOCKS5ClientSocket handshake loop; the UDP data path frames each
+// datagram per RFC 1928 section 7. Warm sockets from Socks5WarmPool
+// skip the greet/auth states. NetLog: SOCKS5_UDP_ASSOCIATE_TARGET
+// wraps the associate flow and SOCKS5_UDP_SEND_TO_TARGET marks every
+// framed send (both event names are vendor-binary strings).
+
+#include "net/socket/socks5_datagram_client_socket.h"
+
+#include <stdint.h>
+
+#include <array>
+#include <cstring>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/memory/ref_counted.h"
+#include "base/notreached.h"
+#include "base/numerics/byte_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "net/base/io_buffer.h"
+#include "net/base/ip_address.h"
+#include "net/base/net_errors.h"
+#include "net/base/sys_addrinfo.h"
+#include "net/log/net_log_event_type.h"
+#include "net/socket/client_socket_factory.h"
+#include "net/socket/socks5_warm_pool.h"
+#include "net/socket/stream_socket.h"
+
+namespace net {
+
+namespace {
+
+// Stealth Chromium: traffic annotation for the SOCKS5 UDP relay path
+// (symbol-observed in the vendor binary as (anonymous
+// ns)::kSocks5UdpTrafficAnnotation).
+constexpr NetworkTrafficAnnotationTag kSocks5UdpTrafficAnnotation =
+    DefineNetworkTrafficAnnotation("socks5_udp_associate", R"(
+      semantics {
+        sender: "SOCKS5DatagramClientSocket"
+        description:
+          "Relays UDP datagrams (QUIC/HTTP-3 traffic) through a SOCKS5 "
+          "proxy using the protocol's UDP ASSOCIATE command. A TCP "
+          "control connection performs the SOCKS5 greeting, optional "
+          "username/password authentication and the associate request; "
+          "datagrams are then sent to the relay endpoint the proxy "
+          "returned."
+        trigger:
+          "A QUIC connection is attempted while the browser is "
+          "configured to use a SOCKS5 proxy."
+        data: "Arbitrary UDP payloads (QUIC packets) addressed to the "
+          "destination the caller connected to."
+        destination: OTHER
+        destination_other:
+          "The configured SOCKS5 proxy, which relays to the destination."
+      }
+      policy {
+        cookies_allowed: NO
+        setting:
+          "This feature is active only when a SOCKS5 proxy is configured "
+          "via --proxy-server or system proxy settings."
+        policy_exception_justification: "Not implemented."
+      })");
+
+constexpr uint8_t kSOCKS5Version = 0x05;
+constexpr uint8_t kNoAuthMethod = 0x00;
+constexpr uint8_t kUsernamePasswordMethod = 0x02;
+constexpr uint8_t kUsernamePasswordVersion = 0x01;
+constexpr uint8_t kUdpAssociateCommand = 0x03;
+constexpr uint8_t kNullByte = 0x00;
+
+constexpr unsigned int kGreetReplySize = 2;
+constexpr unsigned int kAuthReplySize = 2;
+constexpr unsigned int kAssociateReplyHeaderSize = 5;
+
+// RSV(2) + FRAG(1) + ATYP(1) + ADDR(16) + PORT(2): worst-case UDP header.
+constexpr size_t kMaxUdpHeaderSize = 22;
+
+// Largest UDP payload we are willing to relay in one datagram.
+constexpr int kMaxUdpPayloadSize = 65535 - kMaxUdpHeaderSize;
+
+// Address types (RFC 1928).
+constexpr uint8_t kAtypIpv4 = 0x01;
+constexpr uint8_t kAtypDomain = 0x03;
+constexpr uint8_t kAtypIpv6 = 0x04;
+
+}  // namespace
+
+SOCKS5DatagramClientSocket::SOCKS5DatagramClientSocket(
+    DatagramSocket::BindType bind_type,
+    const ProxyServer& proxy_server,
+    ClientSocketFactory* client_socket_factory,
+    HostResolver* host_resolver,
+    NetLog* net_log,
+    const NetLogSource& source)
+    : bind_type_(bind_type),
+      proxy_server_(proxy_server),
+      client_socket_factory_(client_socket_factory),
+      host_resolver_(host_resolver),
+      net_log_(NetLogWithSource::Make(net_log, source)) {}
+
+SOCKS5DatagramClientSocket::~SOCKS5DatagramClientSocket() {
+  Close();
+}
+
+// static
+base::DictValue SOCKS5DatagramClientSocket::UdpTargetNetLogParams(
+    std::optional<int> net_error) {
+  base::DictValue dict;
+  if (net_error.has_value()) {
+    dict.Set("net_error", *net_error);
+  }
+  return dict;
+}
+
+int SOCKS5DatagramClientSocket::Connect(const IPEndPoint& address) {
+  return ConnectInternal(bind_type_, handles::kInvalidNetworkHandle, address,
+                         CompletionOnceCallback());
+}
+
+int SOCKS5DatagramClientSocket::ConnectUsingNetwork(
+    handles::NetworkHandle network,
+    const IPEndPoint& address) {
+  return ConnectInternal(bind_type_, network, address,
+                         CompletionOnceCallback());
+}
+
+int SOCKS5DatagramClientSocket::ConnectUsingDefaultNetwork(
+    const IPEndPoint& address) {
+  return ConnectInternal(bind_type_, handles::kInvalidNetworkHandle, address,
+                         CompletionOnceCallback());
+}
+
+int SOCKS5DatagramClientSocket::ConnectAsync(const IPEndPoint& address,
+                                             CompletionOnceCallback callback) {
+  return ConnectInternal(bind_type_, handles::kInvalidNetworkHandle, address,
+                         std::move(callback));
+}
+
+int SOCKS5DatagramClientSocket::ConnectUsingNetworkAsync(
+    handles::NetworkHandle network,
+    const IPEndPoint& address,
+    CompletionOnceCallback callback) {
+  return ConnectInternal(bind_type_, network, address, std::move(callback));
+}
+
+int SOCKS5DatagramClientSocket::ConnectUsingDefaultNetworkAsync(
+    const IPEndPoint& address,
+    CompletionOnceCallback callback) {
+  return ConnectInternal(bind_type_, handles::kInvalidNetworkHandle, address,
+                         std::move(callback));
+}
+
+handles::NetworkHandle SOCKS5DatagramClientSocket::GetBoundNetwork() const {
+  return udp_socket_ ? udp_socket_->GetBoundNetwork()
+                     : handles::kInvalidNetworkHandle;
+}
+
+void SOCKS5DatagramClientSocket::ApplySocketTag(const SocketTag& tag) {
+  if (udp_socket_) {
+    udp_socket_->ApplySocketTag(tag);
+  }
+}
+
+int SOCKS5DatagramClientSocket::SetMulticastInterface(
+    uint32_t interface_index) {
+  if (udp_socket_) {
+    return udp_socket_->SetMulticastInterface(interface_index);
+  }
+  return ERR_UNEXPECTED;
+}
+
+void SOCKS5DatagramClientSocket::EnableRecvOptimization() {
+  enable_recv_optimization_ = true;
+  if (udp_socket_) {
+    udp_socket_->EnableRecvOptimization();
+  }
+}
+
+void SOCKS5DatagramClientSocket::Close() {
+  connected_ = false;
+  next_state_ = STATE_NONE;
+  connect_callback_.Reset();
+  resolve_request_.reset();
+  transport_socket_.reset();
+  udp_socket_.reset();
+  write_buf_.reset();
+  read_buf_.reset();
+  incoming_read_buf_.reset();
+  outgoing_write_buf_.reset();
+  transport_is_warm_ = false;
+  need_auth_ = false;
+}
+
+int SOCKS5DatagramClientSocket::GetPeerAddress(IPEndPoint* address) const {
+  if (!connected_) {
+    return ERR_UNEXPECTED;
+  }
+  *address = associate_target_;
+  return OK;
+}
+
+int SOCKS5DatagramClientSocket::GetLocalAddress(IPEndPoint* address) const {
+  if (!udp_socket_) {
+    return ERR_UNEXPECTED;
+  }
+  return udp_socket_->GetLocalAddress(address);
+}
+
+void SOCKS5DatagramClientSocket::UseNonBlockingIO() {
+  use_non_blocking_io_ = true;
+  if (udp_socket_) {
+    udp_socket_->UseNonBlockingIO();
+  }
+}
+
+int SOCKS5DatagramClientSocket::SetDoNotFragment() {
+  if (!udp_socket_) {
+    return ERR_UNEXPECTED;
+  }
+  return udp_socket_->SetDoNotFragment();
+}
+
+int SOCKS5DatagramClientSocket::SetRecvTos() {
