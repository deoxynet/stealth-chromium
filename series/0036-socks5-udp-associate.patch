+    if (read_buf_->offset() == kReadHeaderSize) {
+      base::span<uint8_t> data = read_buf_->span_before_offset();
+      if (data[0] != 0x05 || data[2] != 0x00) {
+        return ERR_SOCKS_CONNECTION_FAILED;
