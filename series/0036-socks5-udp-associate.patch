+// found in the LICENSE file of the source tree (Stealth Chromium).
+
+// Stealth Chromium (spec: patches/38-socks5-udp-associate-warm-pool.md):
+// SOCKS5 warm pool implementation. Each warm entry runs its own
+// connect/greet(/auth) state machine on a raw TCP socket created by the
+// ClientSocketFactory; completed entries wait in |warm_| until
+// TakeWarmSocket() hands them out. Timing constants are reconstructed
+// (the vendor's exact refill policy was not recoverable) and documented
+// in the spec's "Repro notes".
+
+#include "net/socket/socks5_warm_pool.h"
+
+#include <stdint.h>
+
+#include <array>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/ref_counted.h"
+#include "base/notreached.h"
+#include "base/numerics/byte_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "net/base/io_buffer.h"
+#include "net/base/ip_endpoint.h"
+#include "net/base/net_errors.h"
+#include "net/base/sys_addrinfo.h"
+#include "net/log/net_log_with_source.h"
+#include "net/socket/client_socket_factory.h"
+#include "net/socket/stream_socket.h"
+
+namespace net {
+
+namespace {
+
+// SOCKS5 protocol constants (RFC 1928 / RFC 1929).
+constexpr uint8_t kSOCKS5Version = 0x05;
+constexpr uint8_t kNoAuthMethod = 0x00;
+constexpr uint8_t kUsernamePasswordMethod = 0x02;
+constexpr uint8_t kUsernamePasswordVersion = 0x01;
+
+constexpr unsigned int kGreetReplySize = 2;
+constexpr unsigned int kAuthReplySize = 2;
+
+// Target number of warm sockets kept in |warm_|.
+constexpr size_t kTargetWarmSockets = 2;
+// Concurrent in-flight connect+greet+auth attempts.
+constexpr size_t kMaxPendingSockets = 1;
+// Warm entries older than this are dropped by PurgeStale().
+constexpr base::TimeDelta kWarmTtl = base::Seconds(30);
+
+}  // namespace
+
+Socks5WarmPool::PendingEntry::PendingEntry() = default;
+Socks5WarmPool::PendingEntry::PendingEntry(PendingEntry&&) = default;
+Socks5WarmPool::PendingEntry& Socks5WarmPool::PendingEntry::operator=(
+    PendingEntry&&) = default;
+Socks5WarmPool::PendingEntry::~PendingEntry() = default;
+
+Socks5WarmPool::WarmEntry::WarmEntry(std::unique_ptr<StreamSocket> socket,
+                                     base::TimeTicks created)
+    : socket(std::move(socket)), created(created) {}
+Socks5WarmPool::WarmEntry::WarmEntry(WarmEntry&&) = default;
+Socks5WarmPool::WarmEntry& Socks5WarmPool::WarmEntry::operator=(
+    WarmEntry&&) = default;
+Socks5WarmPool::WarmEntry::~WarmEntry() = default;
+
+Socks5WarmPool::Socks5WarmPool() = default;
+Socks5WarmPool::~Socks5WarmPool() = default;
+
+// static
+Socks5WarmPool* Socks5WarmPool::GetInstance() {
+  static base::NoDestructor<Socks5WarmPool> instance;
+  return instance.get();
+}
+
+// static
+void Socks5WarmPool::SetProxyCredentials(
+    std::optional<AuthCredentials> credentials) {
+  Socks5WarmPool* pool = GetInstance();
+  // Existing warm sockets authenticated with the old credentials; drop
+  // them so nothing stale is handed out.
+  if (pool->credentials_.has_value() != credentials.has_value()) {
+    pool->pending_.clear();
+    pool->warm_.clear();
+  }
+  pool->credentials_ = std::move(credentials);
+}
+
+// static
+const std::optional<AuthCredentials>& Socks5WarmPool::GetProxyCredentials() {
+  return GetInstance()->credentials_;
+}
+
+size_t Socks5WarmPool::GetSizeForTesting() const {
+  return pending_.size() + warm_.size();
+}
+
+void Socks5WarmPool::Initialize(
+    const AddressList& proxy_addresses,
+    std::optional<AuthCredentials> credentials,
+    ClientSocketFactory* client_socket_factory,
+    NetLog* net_log,
+    const NetworkTrafficAnnotationTag& traffic_annotation) {
+  if (proxy_addresses.empty()) {
+    return;
+  }
+  const bool unchanged =
+      client_socket_factory_ == client_socket_factory &&
+      proxy_addresses_.size() == proxy_addresses.size() &&
+      !proxy_addresses_.empty() &&
+      proxy_addresses_.front() == proxy_addresses.front() &&
+      credentials_.has_value() == credentials.has_value();
+  if (unchanged) {
+    // Already primed for this configuration; just top up.
+    PurgeStale();
+    StartOneConnect();
+    return;
+  }
+
+  pending_.clear();
+  warm_.clear();
+  proxy_addresses_ = proxy_addresses;
+  credentials_ = std::move(credentials);
+  client_socket_factory_ = client_socket_factory;
+  net_log_ = net_log;
+  traffic_annotation_ = traffic_annotation;
+
+  StartOneConnect();
+}
+
+void Socks5WarmPool::StartOneConnect() {
+  if (!client_socket_factory_ || proxy_addresses_.empty()) {
+    return;
+  }
+  if (warm_.size() + pending_.size() >=
+      kTargetWarmSockets + kMaxPendingSockets) {
+    return;
+  }
+
+  auto entry = std::make_unique<PendingEntry>();
+  // Warm connects start from the first address (the pool is an
+  // optimization; the primary connect path keeps its own happy-eyeballs
+  // behavior).
+  entry->address_index = 0;
+  AddressList address_list(proxy_addresses_.front());
+  auto transport = client_socket_factory_->CreateTransportClientSocket(
+      address_list, /*socket_performance_watcher=*/nullptr,
+      /*network_quality_estimator=*/nullptr, net_log_, NetLogSource());
+  StreamSocket* socket = transport.get();
+  entry->socket = std::move(transport);
+  pending_.emplace(socket, std::move(*entry.release()));
+
+  int rv = socket->Connect(base::BindOnce(
+      &Socks5WarmPool::OnTcpConnectComplete, base::Unretained(this), socket));
+  if (rv != ERR_IO_PENDING) {
+    OnTcpConnectComplete(socket, rv);
+  }
+}
+
+std::unique_ptr<StreamSocket> Socks5WarmPool::TakeWarmSocket() {
+  PurgeStale();
+  StartOneConnect();
+  if (warm_.empty()) {
+    return nullptr;
+  }
+  std::unique_ptr<StreamSocket> socket = std::move(warm_.front().socket);
+  warm_.erase(warm_.begin());
+  StartOneConnect();
+  return socket;
+}
+
+void Socks5WarmPool::PurgeStale() {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  std::erase_if(warm_, [&](const WarmEntry& entry) {
+    return now - entry.created > kWarmTtl;
+  });
+}
+
+void Socks5WarmPool::PromoteToWarm(StreamSocket* socket) {
+  auto it = pending_.find(socket);
+  if (it == pending_.end()) {
+    return;
+  }
+  PendingEntry entry = std::move(it->second);
+  pending_.erase(it);
+  warm_.emplace_back(std::move(entry.socket), base::TimeTicks::Now());
+}
+
+Socks5WarmPool::PendingEntry* Socks5WarmPool::FindPending(
+    StreamSocket* socket) {
+  auto it = pending_.find(socket);
+  return it == pending_.end() ? nullptr : &it->second;
+}
+
+void Socks5WarmPool::DestroyPending(StreamSocket* socket) {
+  pending_.erase(socket);
+}
+
+void Socks5WarmPool::OnTcpConnectComplete(StreamSocket* socket, int result) {
+  PendingEntry* entry = FindPending(socket);
+  if (!entry) {
+    return;
+  }
+  if (result != OK) {
+    DestroyPending(socket);
+    return;
+  }
+
+  // Build the greeting: offered methods are "no auth" plus
+  // username/password when credentials are configured.
+  std::vector<uint8_t> greet{kSOCKS5Version, 0x01, kNoAuthMethod};
+  if (credentials_) {
+    greet[1] = 0x02;
+    greet.push_back(kUsernamePasswordMethod);
+  }
+  auto base_buffer = base::MakeRefCounted<VectorIOBuffer>(std::move(greet));
+  entry->write_buf = base::MakeRefCounted<DrainableIOBuffer>(
+      std::move(base_buffer), base_buffer->size());
+
+  int rv = socket->Write(
+      entry->write_buf.get(), entry->write_buf->BytesRemaining(),
+      base::BindOnce(&Socks5WarmPool::OnGreetWriteComplete,
+                     base::Unretained(this), socket),
+      traffic_annotation_);
+  if (rv != ERR_IO_PENDING) {
+    OnGreetWriteComplete(socket, rv);
+  }
+}
+
+void Socks5WarmPool::OnGreetWriteComplete(StreamSocket* socket, int result) {
+  PendingEntry* entry = FindPending(socket);
+  if (!entry) {
+    return;
+  }
+  if (result < 0) {
+    DestroyPending(socket);
+    return;
+  }
+  entry->write_buf->DidConsume(result);
+  if (entry->write_buf->BytesRemaining() > 0) {
+    int rv = socket->Write(
+        entry->write_buf.get(), entry->write_buf->BytesRemaining(),
+        base::BindOnce(&Socks5WarmPool::OnGreetWriteComplete,
+                       base::Unretained(this), socket),
+        traffic_annotation_);
+    if (rv == ERR_IO_PENDING) {
+      return;
+    }
+    OnGreetWriteComplete(socket, rv);
+    return;
+  }
+  entry->write_buf.reset();
+  entry->read_buf = base::MakeRefCounted<GrowableIOBuffer>();
+  entry->read_buf->SetCapacity(kGreetReplySize);
+  int rv = socket->Read(
+      entry->read_buf.get(), entry->read_buf->RemainingCapacity(),
+      base::BindOnce(&Socks5WarmPool::OnGreetReadComplete,
+                     base::Unretained(this), socket));
+  if (rv != ERR_IO_PENDING) {
+    OnGreetReadComplete(socket, rv);
+  }
+}
+
+void Socks5WarmPool::OnGreetReadComplete(StreamSocket* socket, int result) {
+  PendingEntry* entry = FindPending(socket);
+  if (!entry) {
+    return;
+  }
+  if (result < 0) {
+    DestroyPending(socket);
+    return;
+  }
+  if (result == 0) {
+    // Unexpected close during greeting.
+    DestroyPending(socket);
+    return;
+  }
+  entry->read_buf->set_offset(entry->read_buf->offset() + result);
+  if (entry->read_buf->RemainingCapacity() > 0) {
+    int rv = socket->Read(
+        entry->read_buf.get(), entry->read_buf->RemainingCapacity(),
+        base::BindOnce(&Socks5WarmPool::OnGreetReadComplete,
+                       base::Unretained(this), socket));
+    if (rv == ERR_IO_PENDING) {
+      return;
+    }
+    OnGreetReadComplete(socket, rv);
+    return;
+  }
+
+  base::span<uint8_t> data = entry->read_buf->span_before_offset();
+  if (data[0] != kSOCKS5Version) {
+    DestroyPending(socket);
+    return;
+  }
+  const uint8_t method = data[1];
+  if (method == kUsernamePasswordMethod && credentials_) {
+    // RFC 1929 username/password subnegotiation.
+    entry->selected_method = method;
+    const std::string username = base::UTF16ToUTF8(credentials_->username());
+    const std::string password = base::UTF16ToUTF8(credentials_->password());
+    if (username.size() > 0xFF || password.size() > 0xFF) {
+      DestroyPending(socket);
+      return;
+    }
+    std::vector<uint8_t> auth;
+    auth.reserve(3 + username.size() + password.size());
+    auth.push_back(kUsernamePasswordVersion);
+    auth.push_back(static_cast<uint8_t>(username.size()));
+    auth.insert(auth.end(), username.begin(), username.end());
+    auth.push_back(static_cast<uint8_t>(password.size()));
+    auth.insert(auth.end(), password.begin(), password.end());
+    auto base_buffer = base::MakeRefCounted<VectorIOBuffer>(std::move(auth));
+    entry->write_buf = base::MakeRefCounted<DrainableIOBuffer>(
+        std::move(base_buffer), base_buffer->size());
+    int rv = socket->Write(
+        entry->write_buf.get(), entry->write_buf->BytesRemaining(),
+        base::BindOnce(&Socks5WarmPool::OnAuthWriteComplete,
+                       base::Unretained(this), socket),
+        traffic_annotation_);
+    if (rv != ERR_IO_PENDING) {
+      OnAuthWriteComplete(socket, rv);
+    }
+    return;
+  }
+  if (method != kNoAuthMethod) {
+    // No acceptable methods.
+    DestroyPending(socket);
+    return;
+  }
+
+  entry->selected_method = kNoAuthMethod;
+  entry->read_buf.reset();
+  PromoteToWarm(socket);
+}
+
+void Socks5WarmPool::OnAuthWriteComplete(StreamSocket* socket, int result) {
+  PendingEntry* entry = FindPending(socket);
+  if (!entry) {
+    return;
+  }
+  if (result < 0) {
+    DestroyPending(socket);
+    return;
+  }
+  entry->write_buf->DidConsume(result);
+  if (entry->write_buf->BytesRemaining() > 0) {
+    int rv = socket->Write(
+        entry->write_buf.get(), entry->write_buf->BytesRemaining(),
+        base::BindOnce(&Socks5WarmPool::OnAuthWriteComplete,
+                       base::Unretained(this), socket),
+        traffic_annotation_);
+    if (rv == ERR_IO_PENDING) {
+      return;
+    }
+    OnAuthWriteComplete(socket, rv);
+    return;
+  }
+  entry->write_buf.reset();
+  entry->read_buf = base::MakeRefCounted<GrowableIOBuffer>();
+  entry->read_buf->SetCapacity(kAuthReplySize);
+  int rv = socket->Read(
+      entry->read_buf.get(), entry->read_buf->RemainingCapacity(),
+      base::BindOnce(&Socks5WarmPool::OnAuthReadComplete,
+                     base::Unretained(this), socket));
+  if (rv != ERR_IO_PENDING) {
+    OnAuthReadComplete(socket, rv);
+  }
+}
+
+void Socks5WarmPool::OnAuthReadComplete(StreamSocket* socket, int result) {
+  PendingEntry* entry = FindPending(socket);
+  if (!entry) {
+    return;
+  }
+  if (result <= 0) {
+    DestroyPending(socket);
+    return;
+  }
+  entry->read_buf->set_offset(entry->read_buf->offset() + result);
+  if (entry->read_buf->RemainingCapacity() > 0) {
+    int rv = socket->Read(
+        entry->read_buf.get(), entry->read_buf->RemainingCapacity(),
+        base::BindOnce(&Socks5WarmPool::OnAuthReadComplete,
+                       base::Unretained(this), socket));
+    if (rv == ERR_IO_PENDING) {
+      return;
+    }
+    OnAuthReadComplete(socket, rv);
+    return;
+  }
+
+  base::span<uint8_t> data = entry->read_buf->span_before_offset();
+  // Version must be 1; a non-zero status means authentication failed.
+  if (data[0] != kUsernamePasswordVersion || data[1] != 0x00) {
+    DestroyPending(socket);
+    return;
+  }
+  entry->read_buf.reset();
+  PromoteToWarm(socket);
+}
+
+// Socks5WarmTunnelClientSocket finishes a SOCKS5 CONNECT over a socket
+// that has already completed method negotiation (and auth). It mirrors
+// SOCKS5ClientSocket's request/response handling without re-sending the
+// greeting.
+class Socks5WarmTunnelClientSocket : public StreamSocket {
+ public:
+  Socks5WarmTunnelClientSocket(
+      std::unique_ptr<StreamSocket> transport_socket,
+      const HostPortPair& destination,
+      const NetworkTrafficAnnotationTag& traffic_annotation)
+      : io_callback_(base::BindRepeating(&Socks5WarmTunnelClientSocket::
+                                             OnIOComplete,
+                                         base::Unretained(this))),
+        transport_socket_(std::move(transport_socket)),
+        destination_(destination),
+        net_log_(transport_socket_->NetLog()),
+        traffic_annotation_(traffic_annotation) {}
+
+  Socks5WarmTunnelClientSocket(const Socks5WarmTunnelClientSocket&) = delete;
+  Socks5WarmTunnelClientSocket& operator=(const Socks5WarmTunnelClientSocket&) =
+      delete;
+
+  ~Socks5WarmTunnelClientSocket() override { Disconnect(); }
+
+  // StreamSocket implementation.
+  int Connect(CompletionOnceCallback callback) override {
+    DCHECK_EQ(STATE_NONE, next_state_);
+    if (completed_handshake_) {
+      return OK;
+    }
+    next_state_ = STATE_REQUEST_WRITE;
+    int rv = DoLoop(OK);
+    if (rv == ERR_IO_PENDING) {
+      user_callback_ = std::move(callback);
+    }
+    return rv;
+  }
+
+  void Disconnect() override {
+    completed_handshake_ = false;
+    transport_socket_->Disconnect();
+    next_state_ = STATE_NONE;
+    user_callback_.Reset();
+  }
+
+  bool IsConnected() const override {
+    return completed_handshake_ && transport_socket_->IsConnected();
+  }
+
+  bool IsConnectedAndIdle() const override {
+    return completed_handshake_ && transport_socket_->IsConnectedAndIdle();
+  }
+
+  const NetLogWithSource& NetLog() const override { return net_log_; }
+
+  bool WasEverUsed() const override {
+    return transport_socket_->WasEverUsed();
+  }
+
+  NextProto GetNegotiatedProtocol() const override {
+    return transport_socket_->GetNegotiatedProtocol();
+  }
+
+  bool GetSSLInfo(SSLInfo* ssl_info) override {
+    return transport_socket_->GetSSLInfo(ssl_info);
+  }
+
+  int64_t GetTotalReceivedBytes() const override {
+    return transport_socket_->GetTotalReceivedBytes();
+  }
+
+  void ApplySocketTag(const SocketTag& tag) override {
+    transport_socket_->ApplySocketTag(tag);
+  }
+
+  int Read(IOBuffer* buf,
+           int buf_len,
+           CompletionOnceCallback callback) override {
+    DCHECK(completed_handshake_);
+    return transport_socket_->Read(buf, buf_len, std::move(callback));
+  }
+
+  int Write(IOBuffer* buf,
+            int buf_len,
+            CompletionOnceCallback callback,
+            const NetworkTrafficAnnotationTag& traffic_annotation) override {
+    DCHECK(completed_handshake_);
+    return transport_socket_->Write(buf, buf_len, std::move(callback),
+                                    traffic_annotation);
+  }
+
+  int SetReceiveBufferSize(int32_t size) override {
+    return transport_socket_->SetReceiveBufferSize(size);
+  }
+
+  int SetSendBufferSize(int32_t size) override {
+    return transport_socket_->SetSendBufferSize(size);
+  }
+
+  int GetPeerAddress(IPEndPoint* address) const override {
+    return transport_socket_->GetPeerAddress(address);
+  }
+
+  int GetLocalAddress(IPEndPoint* address) const override {
+    return transport_socket_->GetLocalAddress(address);
+  }
+
+ private:
+  enum State {
+    STATE_NONE,
+    STATE_REQUEST_WRITE,
+    STATE_REQUEST_WRITE_COMPLETE,
+    STATE_REQUEST_READ,
+    STATE_REQUEST_READ_COMPLETE,
+  };
+
+  void OnIOComplete(int result) {
+    int rv = DoLoop(result);
+    if (rv != ERR_IO_PENDING && !user_callback_.is_null()) {
+      std::move(user_callback_).Run(rv);
+    }
+  }
+
+  int DoLoop(int last_io_result) {
+    int rv = last_io_result;
+    do {
+      State state = next_state_;
+      next_state_ = STATE_NONE;
+      switch (state) {
+        case STATE_REQUEST_WRITE:
+          DCHECK_EQ(OK, rv);
+          rv = DoRequestWrite();
+          break;
+        case STATE_REQUEST_WRITE_COMPLETE:
+          rv = DoRequestWriteComplete(rv);
+          break;
+        case STATE_REQUEST_READ:
+          DCHECK_EQ(OK, rv);
+          rv = DoRequestRead();
+          break;
+        case STATE_REQUEST_READ_COMPLETE:
+          rv = DoRequestReadComplete(rv);
+          break;
+        default:
+          NOTREACHED() << "bad state";
+      }
+    } while (rv != ERR_IO_PENDING && next_state_ != STATE_NONE);
+    return rv;
+  }
+
+  int DoRequestWrite() {
+    if (0xFF < destination_.host().size()) {
+      return ERR_SOCKS_CONNECTION_FAILED;
+    }
+    next_state_ = STATE_REQUEST_WRITE_COMPLETE;
+    if (!write_buf_) {
+      std::vector<uint8_t> request;
+      request.reserve(7 + destination_.host().size());
+      request.push_back(0x05);
+      request.push_back(0x01);  // CONNECT command.
