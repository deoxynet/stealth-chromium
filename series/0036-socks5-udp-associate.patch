+// found in the LICENSE file of the source tree (Stealth Chromium).
+
+// Stealth Chromium (spec: patches/38-socks5-udp-associate-warm-pool.md):
+// SOCKS5 UDP ASSOCIATE datagram client socket. Runs the RFC 1928
+// greeting (plus RFC 1929 username/password auth when the warm pool
+// carries credentials) and the UDP ASSOCIATE command over a TCP control
+// connection to the proxy, then frames every datagram with the SOCKS5
+// UDP header and relays it through the associate target over a plain
+// UDP socket. Lets QUIC/HTTP-3 egress through a single-hop SOCKS5
+// proxy, which stock Chromium cannot do (it has no UDP-over-SOCKS5
+// support and disables QUIC on SOCKS proxies).
+//
+// Class/method names follow the vendor binary's symbol table
+// (SOCKS5DatagramClientSocket::{ConnectInternal, DoLoop,
+// UdpTargetNetLogParams, ...}).
+
+#ifndef NET_SOCKET_SOCKS5_DATAGRAM_CLIENT_SOCKET_H_
+#define NET_SOCKET_SOCKS5_DATAGRAM_CLIENT_SOCKET_H_
+
+#include <stdint.h>
+
+#include <memory>
+#include <optional>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/values.h"
+#include "net/base/address_list.h"
+#include "net/base/completion_once_callback.h"
+#include "net/base/completion_repeating_callback.h"
+#include "net/base/ip_endpoint.h"
+#include "net/base/net_export.h"
+#include "net/base/network_handle.h"
+#include "net/base/proxy_server.h"
+#include "net/dns/host_resolver.h"
+#include "net/log/net_log_with_source.h"
+#include "net/socket/datagram_client_socket.h"
+#include "net/socket/datagram_socket.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+
+namespace net {
+
+class ClientSocketFactory;
+class DrainableIOBuffer;
+class GrowableIOBuffer;
+class IOBuffer;
+class IOBufferWithSize;
+class NetLog;
+class SocketTag;
+class StreamSocket;
+struct NetLogSource;
+
+// A DatagramClientSocket that carries UDP datagrams through a SOCKS5
+// proxy via UDP ASSOCIATE (RFC 1928, CMD 3). Connect() runs the
+// associate flow; once connected, Read()/Write() exchange
+// SOCKS5-UDP-framed (RFC 1928 section 7) datagrams with the relay
+// endpoint the proxy returned. The peer address reported to the QUIC
+// layer is the associate target.
+class NET_EXPORT_PRIVATE SOCKS5DatagramClientSocket
+    : public DatagramClientSocket {
+ public:
+  SOCKS5DatagramClientSocket(DatagramSocket::BindType bind_type,
+                             const ProxyServer& proxy_server,
+                             ClientSocketFactory* client_socket_factory,
+                             HostResolver* host_resolver,
+                             NetLog* net_log,
+                             const NetLogSource& source);
+
+  SOCKS5DatagramClientSocket(const SOCKS5DatagramClientSocket&) = delete;
+  SOCKS5DatagramClientSocket& operator=(const SOCKS5DatagramClientSocket&) =
+      delete;
+
+  ~SOCKS5DatagramClientSocket() override;
+
+  // NetLog parameters for the UDP ASSOCIATE target event
+  // (symbol-observed helper; |net_error| is nullopt while the associate
+  // is in progress).
+  static base::DictValue UdpTargetNetLogParams(std::optional<int> net_error);
+
+  // DatagramClientSocket implementation.
+  int Connect(const IPEndPoint& address) override;
+  int ConnectUsingNetwork(handles::NetworkHandle network,
+                          const IPEndPoint& address) override;
+  int ConnectUsingDefaultNetwork(const IPEndPoint& address) override;
+  int ConnectAsync(const IPEndPoint& address,
+                   CompletionOnceCallback callback) override;
+  int ConnectUsingNetworkAsync(handles::NetworkHandle network,
+                               const IPEndPoint& address,
+                               CompletionOnceCallback callback) override;
+  int ConnectUsingDefaultNetworkAsync(
+      const IPEndPoint& address,
+      CompletionOnceCallback callback) override;
+  handles::NetworkHandle GetBoundNetwork() const override;
+  void ApplySocketTag(const SocketTag& tag) override;
+  int SetMulticastInterface(uint32_t interface_index) override;
+  void EnableRecvOptimization() override;
+
+  // DatagramSocket implementation.
+  void Close() override;
+  int GetPeerAddress(IPEndPoint* address) const override;
+  int GetLocalAddress(IPEndPoint* address) const override;
+  void UseNonBlockingIO() override;
+  int SetDoNotFragment() override;
+  int SetRecvTos() override;
+  int SetTos(DiffServCodePoint dscp, EcnCodePoint ecn) override;
+  void SetMsgConfirm(bool confirm) override;
+  const NetLogWithSource& NetLog() const override;
+  DscpAndEcn GetLastTos() const override;
+
+  // Socket implementation.
+  int Read(IOBuffer* buf,
+           int buf_len,
+           CompletionOnceCallback callback) override;
+  int Write(IOBuffer* buf,
+            int buf_len,
+            CompletionOnceCallback callback,
+            const NetworkTrafficAnnotationTag& traffic_annotation) override;
+  int SetReceiveBufferSize(int32_t size) override;
+  int SetSendBufferSize(int32_t size) override;
+
+ private:
+  enum State {
+    STATE_NONE,
+    STATE_RESOLVE_PROXY,
+    STATE_RESOLVE_PROXY_COMPLETE,
+    STATE_TCP_CONNECT,
+    STATE_TCP_CONNECT_COMPLETE,
+    STATE_GREET_WRITE,
+    STATE_GREET_WRITE_COMPLETE,
+    STATE_GREET_READ,
+    STATE_GREET_READ_COMPLETE,
+    STATE_AUTH_WRITE,
+    STATE_AUTH_WRITE_COMPLETE,
+    STATE_AUTH_READ,
+    STATE_AUTH_READ_COMPLETE,
+    STATE_ASSOCIATE_WRITE,
+    STATE_ASSOCIATE_WRITE_COMPLETE,
+    STATE_ASSOCIATE_READ,
+    STATE_ASSOCIATE_READ_COMPLETE,
+    STATE_UDP_CONNECT,
+    STATE_UDP_CONNECT_COMPLETE,
+  };
+
+  // Runs the full connect flow (symbol-observed entry point): resolve
+  // the proxy, TCP connect, greet(/auth), UDP ASSOCIATE, then connect
+  // the relay UDP socket.
+  int ConnectInternal(DatagramSocket::BindType bind_type,
+                      handles::NetworkHandle network,
+                      const IPEndPoint& address,
+                      CompletionOnceCallback callback);
+
+  void OnIOComplete(int result);
+  int DoLoop(int last_io_result);
+
+  int DoResolveProxy();
+  int DoResolveProxyComplete(int result);
+  int DoTcpConnect();
+  int DoTcpConnectComplete(int result);
+  int DoGreetWrite();
+  int DoGreetWriteComplete(int result);
+  int DoGreetRead();
+  int DoGreetReadComplete(int result);
+  int DoAuthWrite();
+  int DoAuthWriteComplete(int result);
+  int DoAuthRead();
+  int DoAuthReadComplete(int result);
+  int DoAssociateWrite();
+  int DoAssociateWriteComplete(int result);
+  int DoAssociateRead();
+  int DoAssociateReadComplete(int result);
+  int DoUdpConnect();
+  int DoUdpConnectComplete(int result);
+
+  // UDP data-path helpers: strip the SOCKS5 UDP header from a received
+  // datagram (returns the payload size or a net error) and the async
+  // completion wrappers. The framed/raw buffers are members so they
+  // outlive both the synchronous and asynchronous completions of the
+  // underlying relay-socket operations (one outstanding op per
+  // direction).
+  int ProcessIncomingDatagram(const uint8_t* data,
+                              int len,
+                              IOBuffer* user_buf,
+                              int user_buf_len);
+  void OnUdpReadComplete(raw_ptr<IOBuffer> user_buf,
+                         int user_buf_len,
+                         CompletionOnceCallback callback,
+                         int result);
+  void OnUdpWriteComplete(CompletionOnceCallback callback,
+                          int header_len,
+                          int result);
+
+  // Builds the SOCKS5 UDP request header for |target_| into |header|.
+  static size_t BuildUdpHeader(const IPEndPoint& target, uint8_t* header);
+
+  const DatagramSocket::BindType bind_type_;
+  const ProxyServer proxy_server_;
+
+  raw_ptr<ClientSocketFactory> client_socket_factory_;
+  raw_ptr<HostResolver> host_resolver_;
+  NetLogWithSource net_log_;
+
+  State next_state_ = STATE_NONE;
+  CompletionOnceCallback connect_callback_;
+
+  // The network the relay UDP socket must bind to (kInvalidNetworkHandle
+  // for the default).
+  handles::NetworkHandle network_ = handles::kInvalidNetworkHandle;
+
+  // Set right after construction (the QUIC pool calls UseNonBlockingIO
+  // and EnableRecvOptimization before Connect); applied when the relay
+  // UDP socket is created.
+  bool use_non_blocking_io_ = false;
+  bool enable_recv_optimization_ = false;
+
+  std::unique_ptr<HostResolver::ResolveHostRequest> resolve_request_;
+  AddressList proxy_addresses_;
+
+  // TCP control connection to the proxy.
+  std::unique_ptr<StreamSocket> transport_socket_;
+  // True when transport_socket_ came from Socks5WarmPool (greeting and
+  // auth already completed).
+  bool transport_is_warm_ = false;
+  // True when the proxy selected username/password auth.
+  bool need_auth_ = false;
+
+  scoped_refptr<DrainableIOBuffer> write_buf_;
+  scoped_refptr<GrowableIOBuffer> read_buf_;
+
+  // The QUIC server each datagram is addressed to (set by Connect*).
+  IPEndPoint target_address_;
+  // The UDP relay endpoint the proxy returned (the associate target).
+  IPEndPoint associate_target_;
+
+  // The plain UDP socket carrying framed datagrams to/from the relay.
+  std::unique_ptr<DatagramClientSocket> udp_socket_;
+
+  // Buffers for the in-flight Read/Write on |udp_socket_| (raw on the
+  // read side, SOCKS5-UDP-framed on the write side).
+  scoped_refptr<IOBufferWithSize> incoming_read_buf_;
+  scoped_refptr<IOBufferWithSize> outgoing_write_buf_;
+
+  bool connected_ = false;
+};
+
+}  // namespace net
+
+#endif  // NET_SOCKET_SOCKS5_DATAGRAM_CLIENT_SOCKET_H_
