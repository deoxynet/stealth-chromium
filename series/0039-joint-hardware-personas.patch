+// Stealth Chromium: jointly-sampled hardware device profiles.
+//
+// The vendor build derives every hardware value of an identity from "the
+// most common real-world hardware values ... chosen together so they form
+// a popular, self-consistent device with no internal contradictions"
+// (CHANGELOG 0.4.8). One deterministic selection per (seed, platform)
+// picks a complete profile below, and the persona-default branches of
+// deviceMemory (0004), hardwareConcurrency (0005), the screen dimensions
+// (0007) and the WebGL / WebGPU GPU personas (0016/0032) all read that one
+// entry, replacing the former independent per-field hash defaults which
+// could combine into machines nobody ships.
+//
+// GPU selection reuses the existing persona databases: nvidia_device_id
+// is a PCI id from kNvidiaGpuModels (modules/webgl/gpu_fingerprint.cc and
+// modules/webgpu/webgpu_fingerprint.h share one table; ids are unique),
+// apple_soc is a 0016-style SoC name. No GPU strings live here.
+//
+// Precedence at every consumer: explicit --fingerprint-* override >
+// profile > stock. With fingerprinting disabled ActiveDeviceProfile()
+// returns nullptr and no profile code executes.
+namespace blink::fingerprint {
+
+struct DeviceProfile {
+  int screen_width;  // CSS pixels; what window.screen reports under the persona
+  int screen_height;
+  int color_depth;           // 24 for every entry, matching stock Chrome
+  float device_memory_gb;    // navigator.deviceMemory
+  int hardware_concurrency;  // navigator.hardwareConcurrency (logical cores)
+  uint32_t nvidia_device_id;  // kNvidiaGpuModels entry; 0 on the macOS persona
+  const char* apple_soc;      // macOS persona SoC name; "" everywhere else
+};
+
+// Popular Windows pairings; desktops first, then laptops (1536x864 is a
+// 1920x1080 panel at Windows' 125% scaling, 1366x768 the budget panel).
+inline constexpr DeviceProfile kWindowsDeviceProfiles[] = {
+    {1920, 1080, 24, 8.0f, 8, 0x2507, ""},    // RTX 3050 desktop
+    {1920, 1080, 24, 8.0f, 12, 0x2582, ""},   // RTX 3050 desktop
+    {1920, 1080, 24, 16.0f, 12, 0x2487, ""},  // RTX 3060 desktop
+    {2560, 1440, 24, 16.0f, 12, 0x2486, ""},  // RTX 3060 Ti desktop
+    {2560, 1440, 24, 16.0f, 16, 0x2484, ""},  // RTX 3070 desktop
+    {2560, 1440, 24, 32.0f, 16, 0x2786, ""},  // RTX 4070 desktop
+    {2560, 1440, 24, 16.0f, 16, 0x2C05, ""},  // RTX 5070 Ti desktop
+    {3840, 2160, 24, 32.0f, 16, 0x2704, ""},  // RTX 4080 desktop
+    {3840, 2160, 24, 32.0f, 16, 0x2684, ""},  // RTX 4090 desktop
+    {1920, 1080, 24, 16.0f, 16, 0x2882, ""},  // RTX 4060 desktop
+    {1536, 864, 24, 8.0f, 8, 0x25A2, ""},     // RTX 3050 Laptop GPU
+    {1536, 864, 24, 8.0f, 12, 0x25A0, ""},    // RTX 3050 Ti Laptop GPU
+    {1366, 768, 24, 8.0f, 8, 0x25EC, ""},     // RTX 3050 6GB Laptop GPU
+    {1920, 1080, 24, 8.0f, 12, 0x2520, ""},   // RTX 3060 Laptop GPU
+    {1920, 1080, 24, 16.0f, 12, 0x28E1, ""},  // RTX 4050 Laptop GPU
+    {1920, 1080, 24, 16.0f, 16, 0x28A0, ""},  // RTX 4060 Laptop GPU
+    {2560, 1440, 24, 32.0f, 16, 0x2820, ""},  // RTX 4070 Laptop GPU
+    {1920, 1080, 24, 32.0f, 16, 0x249C, ""},  // RTX 3080 Laptop GPU
+};
+
+// Apple-silicon Macs at their default scaled resolution (window.screen
+// reports the "looks like" size, not the panel size); desktops with
+// common external displays last.
+inline constexpr DeviceProfile kMacOsDeviceProfiles[] = {
+    {1440, 900, 24, 8.0f, 8, 0, "M1"},         // MacBook Air 13" M1
+    {1440, 900, 24, 16.0f, 8, 0, "M1"},        // MacBook Air 13" M1, 16 GB
+    {1470, 956, 24, 8.0f, 8, 0, "M2"},         // MacBook Air 13" M2
