+    {1728, 1117, 24, 32.0f, 16, 0, "M3 Max"},  // MacBook Pro 16" M3 Max
+    {1728, 1117, 24, 32.0f, 16, 0, "M4 Max"},  // MacBook Pro 16" M4 Max
+    {1920, 1080, 24, 8.0f, 8, 0, "M1"},        // Mac mini M1
+    {1920, 1080, 24, 8.0f, 8, 0, "M2"},        // Mac mini M2
+    {2560, 1440, 24, 16.0f, 10, 0, "M4"},      // Mac mini M4
+    {3840, 2160, 24, 32.0f, 12, 0, "M2 Max"},  // Mac Studio M2 Max
