+
+// Linux desktops and Linux-native laptops. The pool is NVIDIA-only: the
+// 0016/0032 Linux vendor and renderer strings are NVIDIA-shaped, and
+// reusing them verbatim is what keeps WebGL, WebGPU and this table
+// coherent.
+inline constexpr DeviceProfile kLinuxDeviceProfiles[] = {
+    {1920, 1080, 24, 8.0f, 8, 0x2507, ""},    // RTX 3050 desktop
+    {1920, 1080, 24, 16.0f, 8, 0x2582, ""},   // RTX 3050 desktop
+    {1920, 1080, 24, 16.0f, 12, 0x2487, ""},  // RTX 3060 desktop
+    {2560, 1440, 24, 16.0f, 12, 0x2486, ""},  // RTX 3060 Ti desktop
+    {2560, 1440, 24, 32.0f, 16, 0x2484, ""},  // RTX 3070 desktop
+    {2560, 1440, 24, 32.0f, 16, 0x2786, ""},  // RTX 4070 desktop
+    {1920, 1080, 24, 32.0f, 16, 0x2882, ""},  // RTX 4060 desktop
+    {3840, 2160, 24, 32.0f, 16, 0x2684, ""},  // RTX 4090 desktop
+    {1920, 1080, 24, 8.0f, 12, 0x2520, ""},   // RTX 3060 Laptop GPU
+    {1920, 1080, 24, 16.0f, 12, 0x28E1, ""},  // RTX 4050 Laptop GPU
+    {1920, 1080, 24, 16.0f, 16, 0x28A0, ""},  // RTX 4060 Laptop GPU
+    {2560, 1440, 24, 16.0f, 16, 0x249C, ""},  // RTX 3080 Laptop GPU
+    {1536, 864, 24, 8.0f, 8, 0x25A2, ""},     // RTX 3050 Laptop GPU
+    {1920, 1080, 24, 8.0f, 8, 0x25EC, ""},    // RTX 3050 6GB Laptop GPU
+};
+
+// The active joint persona, or nullptr when no identity seed is set (the
+// callers' stock fallthrough). Cached like the accessors in
+// fingerprint.h: the command line is immutable by the time renderer code
+// runs. An absent or unrecognized --fingerprint-platform resolves to the
+// Linux tables, matching the GPU persona default in 0016/0032.
+inline const DeviceProfile* ActiveDeviceProfile() {
+  static const DeviceProfile* profile = [] -> const DeviceProfile* {
+    if (!Seed()) {
+      return nullptr;
+    }
+    const DeviceProfile* table = kLinuxDeviceProfiles;
+    size_t count = std::size(kLinuxDeviceProfiles);
+    std::string_view key = "linux";
+    switch (SpoofedPlatform()) {
+      case Platform::kWindows:
+        table = kWindowsDeviceProfiles;
+        count = std::size(kWindowsDeviceProfiles);
+        key = "windows";
+        break;
+      case Platform::kMacOs:
+        table = kMacOsDeviceProfiles;
+        count = std::size(kMacOsDeviceProfiles);
+        key = "macos";
+        break;
+      case Platform::kNone:
+      case Platform::kLinux:
+        break;
+    }
+    // Same seed + same platform ⇒ same profile, always; the platform key
+    // keeps the per-table indices independent.
+    const uint64_t hash = Mix(HashFor("device-profile") ^ Hash(key));
+    return &table[hash % count];
+  }();
+  return profile;
+}
+
+}  // namespace blink::fingerprint
