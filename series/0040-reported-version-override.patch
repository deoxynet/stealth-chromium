+// Stealth Chromium: reported-version UA token (series/0040); the underlying
+// GetVersionNumber() returns PRODUCT_VERSION when fingerprinting is off, so
+// the token is byte-identical to the stock compile-time form then.
+std::string_view GetProductNameAndVersionForUserAgent() {
+  static const std::string product =
+      base::StrCat("Chrome/", GetVersionNumber());
+  return product;
+}
