+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_FINGERPRINT_REPORTED_VERSION_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_FINGERPRINT_REPORTED_VERSION_H_
+
+#include <string>
+
+#include "base/version_info/version_info.h"
+#include "third_party/blink/public/common/fingerprint/fingerprint.h"
+
+// Reported Chrome version, decoupled from the build base (series/0040).
+//
+// A browser frozen on an old Chromium base that reports a year-stale version
+// is a cheap bot signal, so the reported version tracks real Chrome instead
+// of the build base. The single source is version_info::GetVersionNumber(),
+// patched to resolve, in order: --fingerprint-report-version (loosely
+// validated dotted-numeric), else a compile-time default equal to Chrome
+// stable at the last series rebase, else the stock build version.
+//
+// Returns "" when fingerprinting is off so call sites fall back to their
+// stock values byte-for-byte.
+namespace blink::fingerprint {
+
+inline std::string ReportedChromeVersion() {
+  if (!Enabled()) {
+    return std::string();
+  }
+  // base/ cannot depend on blink, so the switch parsing and the default
+  // constant live in base/version_info/version_info.cc.
+  return std::string(version_info::GetVersionNumber());
+}
+
+}  // namespace blink::fingerprint
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_COMMON_FINGERPRINT_REPORTED_VERSION_H_
