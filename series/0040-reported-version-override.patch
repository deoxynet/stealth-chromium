--- a/base/version_info/version_info.cc
+++ b/base/version_info/version_info.cc
@@ -6,13 +6,61 @@
 
 #include <string>
 
+#include "base/command_line.h"
 #include "base/no_destructor.h"
 #include "base/strings/strcat.h"
 #include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
 #include "base/version.h"
 
 namespace version_info {
 
+namespace {
+
+// Stealth Chromium: reported-version override (series/0040). base/ must not
+// depend on blink, so the switch names defined in
+// third_party/blink/public/common/switches.h are spelled out here; keep them
+// in sync.
+constexpr char kFingerprintSwitch[] = "fingerprint";
+constexpr char kFingerprintReportVersionSwitch[] = "fingerprint-report-version";
+
+// Default reported version: current Chrome stable at the last series rebase.
+// TODO(stealth): bump at each rebase (see docs/REBASING.md).
+constexpr char kDefaultReportedChromeVersion[] = "157.0.8103.78";
+
+bool FingerprintingEnabled() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (!command_line.HasSwitch(kFingerprintSwitch)) {
+    return false;
+  }
+  const std::string value = base::ToLowerASCII(
+      command_line.GetSwitchValueASCII(kFingerprintSwitch));
+  return value != "off" && value != "false" && value != "0" &&
+         value != "disable" && value != "disabled";
+}
+
+std::string ReportedVersionNumber() {
+  if (!FingerprintingEnabled()) {
+    return PRODUCT_VERSION;
+  }
+  const std::string override_value =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          kFingerprintReportVersionSwitch);
+  // Loose validation: any dotted numeric form base::Version accepts.
+  if (base::Version(override_value).IsValid()) {
+    return override_value;
+  }
+  return kDefaultReportedChromeVersion;
+}
+
+}  // namespace
+
+std::string_view GetVersionNumber() {
+  static const std::string reported = ReportedVersionNumber();
+  return reported;
+}
+
 int GetMajorVersionNumberAsInt() {
   DCHECK(GetVersion().IsValid());
   return GetVersion().components()[0];
