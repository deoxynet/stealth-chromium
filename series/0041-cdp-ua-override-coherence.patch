+++ b/third_party/blink/public/common/fingerprint/cdp_ua_override.h
@@ -0,0 +1,308 @@
+// Copyright 2026 The Stealth Chromium Authors
+// Use of this source code is governed by a GPLv3 license that can be
+// found in the LICENSE file of the Stealth Chromium distribution.
+
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_FINGERPRINT_CDP_UA_OVERRIDE_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_FINGERPRINT_CDP_UA_OVERRIDE_H_
+
+#include <array>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "third_party/blink/public/common/user_agent/user_agent_metadata.h"
+
+// Stealth Chromium (0041): coherent identity across frames under CDP
+// user-agent overrides. `Emulation.setUserAgentOverride` normally carries
+// only a UA string (e.g. Puppeteer); stock Chromium leaves the client-hints
+// metadata blank or persona/stock depending on the frame. This derivation
+// turns the override string into a full UserAgentMetadata so every frame of
+// the page reports one identity.
+//
+// The override string wins for everything it implies (brand, full version,
+// OS, mobile, model); `persona` — the 0010 persona metadata — fills what it
+// cannot imply (bitness, wow64, form factors, and the tuned platform detail
+// fields when the string's OS matches the persona platform). The brand lists
+// are rebuilt with the GREASE algorithm seeded by the override's major
+// version, matching what stock Chromium of that version would send. Pure and
+// deterministic: the same string and persona give the same metadata on every
+// launch, on every platform.
+
+namespace blink::fingerprint {
+
+namespace cdp_ua_internal {
+
+inline std::string VersionTokenAfter(const std::string& ua, size_t start) {
+  std::string version;
+  for (size_t i = start; i < ua.size(); ++i) {
+    if ((ua[i] >= '0' && ua[i] <= '9') || ua[i] == '.') {
+      version += ua[i];
+    } else {
+      break;
+    }
+  }
+  while (!version.empty() && version.back() == '.') {
+    version.pop_back();
+  }
+  bool has_digit = false;
+  for (char c : version) {
+    if (c >= '0' && c <= '9') {
+      has_digit = true;
+      break;
+    }
+  }
+  return has_digit ? version : std::string();
+}
+
+inline std::string MajorOf(const std::string& version) {
+  const size_t dot = version.find('.');
+  return dot == std::string::npos ? version : version.substr(0, dot);
+}
+
+inline int MajorSeed(const std::string& major) {
+  int seed = 0;
+  for (char c : major) {
+    if (c < '0' || c > '9') {
+      continue;
+    }
+    seed = seed * 10 + (c - '0');
+    if (seed > 1000000) {
+      break;  // Any realistic major version stays far below this clamp.
+    }
+  }
+  return seed;
+}
+
+// Mirrors GetGreasedUserAgentBrandVersion()/GetProcessedGreasedBrandVersion()
+// from components/embedder_support/user_agent_utils.cc, seeded by the
+// override's major version instead of the build's.
+inline UserAgentBrandVersion GreasedBrandVersion(int seed, bool full_version) {
+  static constexpr const char* kChars[] = {" ", "(", ":", "-", ".", "/",
+                                           ")", ";", "=", "?", "_"};
+  static constexpr const char* kVersions[] = {"8", "99", "24"};
+  const std::string version = kVersions[seed % 3];
+  return {std::string("Not") + kChars[seed % 11] + "A" +
+              kChars[(seed + 1) % 11] + "Brand",
+          full_version ? version + ".0.0.0" : version};
+}
+
+// Mirrors ShuffleBrandList()/GetRandomOrder() for the fixed 3-entry list
+// used here (major-version-seeded stable permutation).
+inline UserAgentBrandList ShuffleBrandList3(UserAgentBrandList list,
+                                            int seed) {
+  static constexpr std::array<std::array<size_t, 3>, 6> kOrders{
+      {{0, 1, 2}, {0, 2, 1}, {1, 0, 2}, {1, 2, 0}, {2, 0, 1}, {2, 1, 0}}};
+  const auto& order = kOrders[seed % 6];
+  UserAgentBrandList shuffled(list.size());
+  for (size_t i = 0; i < order.size(); ++i) {
+    shuffled[order[i]] = std::move(list[i]);
+  }
+  return shuffled;
+}
+
+// Platform version implied by an Android token ("Android 13" -> "13.0.0").
+inline std::string AndroidPlatformVersion(const std::string& ua) {
+  const size_t token = ua.find("Android ");
+  if (token == std::string::npos) {
+    return std::string();
+  }
+  const std::string version = VersionTokenAfter(ua, token + 8);
+  if (version.empty()) {
+    return std::string();
+  }
+  return MajorOf(version) + ".0.0";
+}
+
+// Device model: the parenthetical segment after the Android version token,
+// up to " Build/", the next ';' or the closing ')'. Empty when not spelled
+// out.
+inline std::string AndroidModel(const std::string& ua) {
+  const size_t token = ua.find("Android ");
+  if (token == std::string::npos) {
+    return std::string();
+  }
+  size_t start = ua.find(';', token);
+  if (start == std::string::npos) {
+    return std::string();
+  }
+  ++start;
+  while (start < ua.size() && ua[start] == ' ') {
+    ++start;
+  }
+  size_t end = ua.find(" Build/", start);
+  const size_t semi = ua.find(';', start);
+  const size_t paren = ua.find(')', start);
+  if (semi != std::string::npos && (end == std::string::npos || semi < end)) {
+    end = semi;
+  }
+  if (paren != std::string::npos && (end == std::string::npos || paren < end)) {
+    end = paren;
+  }
+  if (end == std::string::npos || end <= start) {
+    return std::string();
+  }
+  return ua.substr(start, end - start);
+}
+
+// Platform version implied by an iOS token ("OS 17_2" -> "17.2.0").
+inline std::string IosPlatformVersion(const std::string& ua) {
+  const size_t token = ua.find("OS ");
+  if (token == std::string::npos) {
+    return std::string();
+  }
+  std::string version;
+  for (size_t i = token + 3; i < ua.size(); ++i) {
+    if ((ua[i] >= '0' && ua[i] <= '9') || ua[i] == '_') {
+      version += ua[i] == '_' ? '.' : ua[i];
+    } else {
+      break;
+    }
+  }
+  if (version.empty()) {
+    return std::string();
+  }
+  // "17_2" arrived as "17.2"; pad to major.minor.patch.
+  size_t dots = 0;
+  for (char c : version) {
+    if (c == '.') {
+      ++dots;
+    }
+  }
+  if (dots == 0) {
+    return version + ".0.0";
+  }
+  if (dots == 1) {
+    return version + ".0";
+  }
+  return version;
+}
+
+}  // namespace cdp_ua_internal
+
+inline UserAgentMetadata DeriveUserAgentMetadataFromOverride(
+    const std::string& user_agent,
+    const UserAgentMetadata& persona) {
+  using namespace cdp_ua_internal;
+
+  UserAgentMetadata metadata = persona;
+
+  // Brand and full version: the last recognized browser token in the string
+  // wins (Edge/Opera/etc. append their token after the Chrome one).
+  struct BrandToken {
+    const char* token;
+    const char* brand;
+  };
+  static constexpr BrandToken kBrandTokens[] = {
+      {"EdgiOS/", "Microsoft Edge"},   {"EdgA/", "Microsoft Edge"},
+      {"Edg/", "Microsoft Edge"},      {"OPR/", "Opera"},
+      {"OPX/", "Opera"},               {"Vivaldi/", "Vivaldi"},
+      {"SamsungBrowser/", "Samsung Internet"}, {"CriOS/", "Google Chrome"},
+      {"Chrome/", "Google Chrome"},    {"Chromium/", "Chromium"},
+  };
+  std::string brand;
+  std::string full_version;
+  size_t best = 0;
+  for (const auto& entry : kBrandTokens) {
+    const size_t pos = user_agent.rfind(entry.token);
+    if (pos == std::string::npos || pos < best) {
+      continue;
+    }
+    const std::string version =
+        VersionTokenAfter(user_agent, pos + std::strlen(entry.token));
+    if (version.empty()) {
+      continue;
+    }
+    best = pos;
+    brand = entry.brand;
+    full_version = version;
+  }
+
+  if (!full_version.empty()) {
+    const std::string major = MajorOf(full_version);
+    const int seed = MajorSeed(major);
+    metadata.full_version = full_version;
+    metadata.brand_full_version_list =
+        ShuffleBrandList3({GreasedBrandVersion(seed, /*full_version=*/true),
+                           {brand, full_version},
+                           {"Chromium", full_version}},
+                          seed);
+    metadata.brand_version_list =
+        ShuffleBrandList3({GreasedBrandVersion(seed, /*full_version=*/false),
+                           {brand, major},
+                           {"Chromium", major}},
+                          seed);
+  }
+
+  // OS-CPU parenthetical. The classic UA freezes or omits most platform
+  // detail, so unmatched fields fall back to the persona; when the string's
+  // OS differs from the persona platform, defaults mirror the 0010 persona
+  // table for that OS.
+  std::string platform;
+  std::string platform_version;
+  std::string architecture;
+  std::string model;
+  bool mobile = false;
+  if (user_agent.find("Windows") != std::string::npos) {
+    platform = "Windows";
+    platform_version = "19.0.0";
+    architecture = "x86";
+  } else if (user_agent.find("Android") != std::string::npos) {
+    platform = "Android";
+    platform_version = AndroidPlatformVersion(user_agent);
+    if (platform_version.empty()) {
+      platform_version = "13.0.0";
+    }
+    architecture = "arm";
+    model = AndroidModel(user_agent);
+    mobile = true;
+  } else if (user_agent.find("iPhone") != std::string::npos ||
+             user_agent.find("iPad") != std::string::npos) {
+    platform = "iOS";
+    platform_version = IosPlatformVersion(user_agent);
+    if (platform_version.empty()) {
+      platform_version = "16.6.0";
+    }
+    architecture = "arm";
+    mobile = true;
+  } else if (user_agent.find("CrOS ") != std::string::npos) {
+    platform = "ChromeOS";
+    const size_t token = user_agent.find("CrOS ");
+    platform_version = VersionTokenAfter(user_agent, token + 5);
+    if (platform_version.empty()) {
+      platform_version = "14541.0.0";
+    }
+    architecture = "x86";
+  } else if (user_agent.find("Macintosh") != std::string::npos ||
+             user_agent.find("Mac OS X") != std::string::npos) {
+    platform = "macOS";
+    platform_version = "15.2.0";  // UA token is frozen at 10_15_7.
+    architecture = "arm";
+  } else if (user_agent.find("X11;") != std::string::npos ||
+             user_agent.find("Linux x86_64") != std::string::npos ||
+             user_agent.find("(X11;") != std::string::npos ||
+             user_agent.find("Linux;") != std::string::npos) {
+    platform = "Linux";
+    platform_version = "6.11.0";
+    architecture = "x86";
+  }
+
+  if (!platform.empty()) {
+    metadata.platform = platform;
+    if (platform != persona.platform) {
+      // The override implies a different OS than the persona: rewrite the
+      // fields the persona had tuned for its own platform.
+      metadata.platform_version = platform_version;
+      metadata.architecture = architecture;
+      metadata.mobile = mobile;
+      if (!model.empty()) {
+        metadata.model = model;
+      }
+    }
+  }
+
+  return metadata;
+}
+
+}  // namespace blink::fingerprint
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_COMMON_FINGERPRINT_CDP_UA_OVERRIDE_H_
