+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_FINGERPRINT_HOST_FONT_ISOLATION_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_FINGERPRINT_HOST_FONT_ISOLATION_H_
+
+#include <string>
+
+#include "base/strings/string_util.h"
+#include "third_party/blink/public/common/fingerprint/fingerprint.h"
+#include "third_party/blink/renderer/platform/fonts/fingerprint_font_databases.h"
+#include "third_party/blink/renderer/platform/fonts/font_face_creation_params.h"
+#include "third_party/blink/renderer/platform/wtf/text/atomic_string.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+// Stealth Chromium: host-font isolation (docs/features/host-font-isolation.md,
+// vendor CHANGELOG 0.5.8 / 0.7.x). 0022 spoofed the reported platform and
+// blocked families that are host-only per the recovered inventories, but the
+// gate was fail-open: families outside every recovered inventory (any
+// user-installed host font) still resolved through the stock fontconfig
+// path, and only cross-platform personas were gated. This header hardens
+// the same FontCache::GetFontPlatformData hook into a persona allowlist:
+// availability follows the persona inventory alone, so no surface below
+// the cache (document.fonts.check, CSS matching, measureText, src:local())
+// can observe which families the host actually has. 0022's
+// ResolveSpoofedFamily is kept verbatim for spec provenance and is
+// superseded by ResolveIsolatedFamily below.
+namespace blink::fingerprint_fonts {
+
+// 0042's hardened form of ResolveSpoofedFamily. Differences, all
+// deliberate:
+//  - No host-platform filter: same-platform personas clamp to their list
+//    too, exactly like cross-platform ones.
+//  - Fail closed: a family that is in no persona inventory resolves as
+//    "not installed" instead of falling through to the host.
+// Windows aliasing and the generic/basic exemptions are unchanged.
+inline FontLookupDecision ResolveIsolatedFamily(
+    const FontFaceCreationParams& creation_params,
+    FontFaceCreationParams& out_params) {
+  if (!fingerprint::Enabled() ||
+      creation_params.CreationType() != kCreateFontByFamily) {
+    return FontLookupDecision::kStock;
+  }
+  const fingerprint::Platform spoofed = fingerprint::SpoofedPlatform();
+  if (spoofed == fingerprint::Platform::kNone) {
+    return FontLookupDecision::kStock;
+  }
+
+  // The allowlist is static per persona (availability follows the persona,
+  // not the seed). Every set consulted below is a base::NoDestructor
+  // static built once; the checks are O(log n) string lookups, noise next
+  // to the fontconfig/Skia match this gate guards.
+  const std::string family =
+      base::ToLowerASCII(creation_params.Family().Utf8());
+  if (IsBasicFont(family)) {
+    return FontLookupDecision::kProceed;
+  }
+
+  const bool known_on_spoofed =
+      GetPlatformFonts(spoofed).count(family) > 0 || FontsDirProvides(family);
+  if (!known_on_spoofed) {
+    // Not in the persona inventory: behave exactly as if not installed.
+    return FontLookupDecision::kUnavailable;
+  }
+
+  if (spoofed == fingerprint::Platform::kWindows) {
+    const auto& aliases = WindowsAliases();
+    const auto it = aliases.find(family);
+    if (it != aliases.end()) {
+      // Intern the substituted name so subsequent matching uses it.
+      out_params = FontFaceCreationParams(
+          AtomicString(String::FromUTF8(it->second)));
+    }
+  }
+  return FontLookupDecision::kProceed;
+}
+
+}  // namespace blink::fingerprint_fonts
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_FINGERPRINT_HOST_FONT_ISOLATION_H_
