   is_updating_ = false;
 
+  // Stealth Chromium: inject the phantom Widevine key system when
+  // fingerprinting is enabled and the browser process reported no real
+  // Widevine info (no CDM component registered). This is the single choke
+  // point where renderer-side key system support is assembled, so support
+  // queries, config negotiation, and CDM creation all agree with it.
+  bool has_real_widevine = false;
+  for (const auto& info : key_systems) {
+    if (info->GetBaseKeySystemName() == kWidevineKeySystem ||
+        IsSubKeySystemOf(info->GetBaseKeySystemName(), kWidevineKeySystem)) {
+      has_real_widevine = true;
+      break;
+    }
+  }
+  const bool phantom_registered =
+      phantom_widevine::Enabled() && !has_real_widevine;
+  if (phantom_registered) {
+    key_systems.emplace_back(
+        std::make_unique<phantom_widevine::PhantomWidevineKeySystemInfo>());
+  }
+  // MojoCdmFactory consults this to keep createMediaKeys() coherent with
+  // the support answer above; a real CDM wins whenever one is registered.
+  phantom_widevine::SetRegistered(phantom_registered);
+
   // Clear Key is always supported.
   key_systems.emplace_back(std::make_unique<ClearKeyKeySystemInfo>());
 
