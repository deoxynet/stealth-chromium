+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FINGERPRINT_POINTER_HOVER_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FINGERPRINT_POINTER_HOVER_H_
+
+#include <optional>
+
+#include "third_party/blink/public/common/fingerprint/fingerprint.h"
+#include "third_party/blink/public/mojom/webpreferences/web_preferences.mojom-blink-forward.h"
+#include "ui/base/pointer/pointer_device.h"
+
+// Pointer/hover media-feature persona shared by every MediaValues
+// implementation (core/css/media_values.cc), so matchMedia, CSS parsing
+// and style recalc cannot disagree.
+//
+// Headless containers report zero input devices: primary/any pointer
+// "none", no hover — an automation signal next to a desktop persona
+// (see the noPointingDevice botstop vector). When fingerprinting is
+// enabled every pointer/hover media feature answers as a desktop with
+// a mouse, coherently with maxTouchPoints 0 (stock) and the device
+// profile's screen dimensions. Deterministic constants: no seed
+// dependence. nullopt → caller falls back to the stock device answer.
+namespace blink::fingerprint {
+
+inline std::optional<mojom::blink::PointerType> SpoofedPrimaryPointerType() {
+  if (!Enabled()) {
+    return std::nullopt;
+  }
+  return mojom::blink::PointerType::kPointerFineType;
+}
+
+inline std::optional<int> SpoofedAvailablePointerTypes() {
+  if (!Enabled()) {
+    return std::nullopt;
+  }
+  // Fine mouse only: no coarse, no touch, and crucially no "none" bit.
+  return ui::POINTER_TYPE_FINE;
+}
+
+inline std::optional<mojom::blink::HoverType> SpoofedPrimaryHoverType() {
+  if (!Enabled()) {
+    return std::nullopt;
+  }
+  return mojom::blink::HoverType::kHoverHoverType;
+}
+
+inline std::optional<int> SpoofedAvailableHoverTypes() {
+  if (!Enabled()) {
+    return std::nullopt;
+  }
+  return ui::HOVER_TYPE_HOVER;
+}
+
+}  // namespace blink::fingerprint
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_FINGERPRINT_POINTER_HOVER_H_
