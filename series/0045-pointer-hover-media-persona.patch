From: Stealth Chromium contributors
Date: Thu, 1 Jan 2026 00:00:00 +0000
Subject: [PATCH 0045] fingerprint: persona pointer and hover media features
X-Spec: pointer hover persona
X-Files: third_party/blink/renderer/core/css/media_values.cc third_party/blink/renderer/core/fingerprint/pointer_hover.h

---

--- a/third_party/blink/renderer/core/css/media_values.cc
+++ b/third_party/blink/renderer/core/css/media_values.cc
@@ -16,6 +16,7 @@
 #include "third_party/blink/renderer/core/dom/document.h"
 #include "third_party/blink/renderer/core/dom/element.h"
 #include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/fingerprint/pointer_hover.h"
 #include "third_party/blink/renderer/core/fingerprint/screen_dimensions.h"
 #include "third_party/blink/renderer/core/frame/local_frame.h"
 #include "third_party/blink/renderer/core/frame/local_frame_view.h"
@@ -364,12 +365,21 @@
     LocalFrame* frame) {
   DCHECK(frame);
   DCHECK(frame->GetSettings());
+  // Stealth Chromium: persona answer before the (possibly empty) real
+  // device list — headless reports kPointerNone against a desktop persona.
+  if (auto t = fingerprint::SpoofedPrimaryPointerType()) {
+    return *t;
+  }
   return frame->GetSettings()->GetPrimaryPointerType();
 }
 
 int MediaValues::CalculateAvailablePointerTypes(LocalFrame* frame) {
   DCHECK(frame);
   DCHECK(frame->GetSettings());
+  // Stealth Chromium: fine mouse only (see fingerprint/pointer_hover.h).
+  if (auto t = fingerprint::SpoofedAvailablePointerTypes()) {
+    return *t;
+  }
   return frame->GetSettings()->GetAvailablePointerTypes();
 }
 
@@ -377,6 +387,10 @@
     LocalFrame* frame) {
   DCHECK(frame);
   DCHECK(frame->GetSettings());
+  // Stealth Chromium: desktop-with-mouse persona claims hover.
+  if (auto h = fingerprint::SpoofedPrimaryHoverType()) {
+    return *h;
+  }
   return frame->GetSettings()->GetPrimaryHoverType();
 }
 
@@ -390,6 +404,10 @@
 int MediaValues::CalculateAvailableHoverTypes(LocalFrame* frame) {
   DCHECK(frame);
   DCHECK(frame->GetSettings());
+  // Stealth Chromium: hover-capable mouse only (see pointer_hover.h).
+  if (auto h = fingerprint::SpoofedAvailableHoverTypes()) {
+    return *h;
+  }
   return frame->GetSettings()->GetAvailableHoverTypes();
 }
 
